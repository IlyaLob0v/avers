#!/usr/bin/env bash
# Открывает в интернет только страницу механиков (/m/) по HTTPS: sudo avers-internet avers.example.ru
# Остальной API (абоненты, оплаты, настольная программа) из интернета не виден.
# Нужно заранее: имя сайта указывает на внешний адрес офиса, роутер пробрасывает порты 80 и 443 на этот сервер.
set -euo pipefail

[ $# -eq 1 ] || { echo "Как: sudo avers-internet <имя сайта>"; exit 1; }
[ "$(id -u)" -eq 0 ] || { echo "Запустите через sudo"; exit 1; }
domain=$1

# Caddy для HTTPS в офисе ставит install.sh; этот сценарий только добавляет к нему сайт для интернета.
grep -qs 'import /etc/caddy/avers-' /etc/caddy/Caddyfile || {
    echo "Сначала обновите сервер Аверса: sudo bash install.sh из свежей сборки."
    exit 1
}

# С учебным паролем avers из интернета вошёл бы кто угодно.
avers-demo-check || { echo "Страница механиков в интернет не открыта."; exit 1; }

cat > /etc/caddy/avers-internet.caddy <<CADDY
$domain {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
    }
    @mechanics path /m /m/* /api/auth/login /api/mobile/*
    handle @mechanics {
        reverse_proxy 127.0.0.1:5115 {
            # Из интернета сервер пускает только механиков (роль «Читатель»).
            header_up X-Avers-Internet 1
        }
    }
    handle {
        respond 404
    }
}
CADDY
systemctl reload caddy

if command -v ufw >/dev/null && ufw status | grep -q "Status: active"; then
    ufw allow 80/tcp
    ufw allow 443/tcp
fi

echo "Страница механиков: https://$domain/m/ (сертификат выпускается автоматически в первые минуты)"
