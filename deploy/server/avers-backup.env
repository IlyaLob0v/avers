# Настройки копий Аверса (avers-backup, avers-restore-check). install.sh кладёт этот файл в /etc/avers-backup.env
# только при первой установке; дальше правьте его там: sudo nano /etc/avers-backup.env

# Сколько дней хранить копии на этом сервере.
AVERS_BACKUP_DAYS=30

# Куда каждую ночь переносить копии на другой компьютер (rsync по ssh-ключу), см. docs/09-server.md.
# Пусто — копии только на этом сервере, в журнал каждую ночь пишется предупреждение.
#AVERS_BACKUP_REMOTE=avers-backup@192.168.1.11:./
#AVERS_BACKUP_KEY=/root/.ssh/avers-backup

# Проверка восстановления: насколько (в процентах) число строк в копии может отличаться от рабочей базы.
#AVERS_RESTORE_TOLERANCE=2
