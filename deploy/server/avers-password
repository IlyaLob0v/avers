#!/usr/bin/env bash
# Сменить пароль сотрудника в Аверсе: sudo avers-password orlov
set -euo pipefail

[ $# -eq 1 ] || { echo "Как: sudo avers-password <логин>"; exit 1; }
[ "$(id -u)" -eq 0 ] || { echo "Запустите через sudo"; exit 1; }

read -r -s -p "Новый пароль для $1: " password; echo
read -r -s -p "Ещё раз: " again; echo
[ "$password" = "$again" ] || { echo "Пароли не совпали"; exit 1; }

connection=$(sed -n 's/^ConnectionStrings__Avers=//p' /etc/avers-server.env)
cd /opt/avers-server
printf '%s\n' "$password" | runuser -u avers -- env ASPNETCORE_ENVIRONMENT=Production Logging__LogLevel__Default=Warning \
    "ConnectionStrings__Avers=$connection" ./Avers.Server set-password "$1"
