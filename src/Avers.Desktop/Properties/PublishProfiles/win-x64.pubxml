<Project>
  <!-- Сборка для установки на Windows (в том числе на терминальный сервер): .NET ставить не нужно. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>bin\publish\Avers\</PublishDir>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Отладочные символы из пакетов SkiaSharp/HarfBuzz весят ~100 МБ и на сервере не нужны. -->
  <Target Name="RemoveNativeSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PdbFiles Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(PdbFiles)" />
  </Target>
</Project>
