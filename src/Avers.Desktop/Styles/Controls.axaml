<!--
  Общие стили Аверса. Классы, которыми пользуются экраны:

  Панели     Border.card (+ TextBlock.legend внутри) или HeaderedContentControl.group Header="…" — рамка-группа
             Border.toolbar — полоса кнопок над экраном; Border.filterbar — полоса фильтров (период, дом, статус)
             Border.actionbar — нижняя полоса с кнопками действий (ОК / Отмена справа)
  Пометки    Border.warn / .debt / .ok / .info / .off — цветная плашка-предупреждение
             Border.badge + .warn/.debt/.ok/.info/.off — маленькая цветная метка в строке
             строки таблицы: ctl:GridTone.Enabled="True" на DataGrid, строка реализует IRowTone (Controls/GridTone.cs)
  Текст      TextBlock.h1 — заголовок экрана, .legend — подпись группы, .label — подпись поля,
             .value — значение для чтения, .money — сумма (вправо, моноширинные цифры), .hint — пояснение, .link — ссылка
  Кнопки     Button.primary — главное действие, Button.link — переход «провалиться» (договор, квартира),
             Button.nav — кнопка модуля в панели навигации, Button.icon — ярлык рабочего стола
  Поля       TextBox.cell, ComboBox.cell — как раньше; DatePicker и CalendarDatePicker уже компактные
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Окно и текст -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="{StaticResource Face}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Caption}" />
  </Style>
  <Style Selector="TextBlock.legend">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Caption}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Margin" Value="0,2,8,2" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.money">
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.link">
    <Setter Property="Foreground" Value="{StaticResource Link}" />
    <Setter Property="TextDecorations" Value="Underline" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Поля ввода: белые, тонкая сине-серая рамка, без скруглений -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.cell">
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="TextBox:readonly">
    <Setter Property="Background" Value="{StaticResource FieldReadOnly}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="TextBox:readonly:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource FieldReadOnly}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ComboBox.cell">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="CalendarDatePicker, DatePicker">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="CheckBox, RadioButton">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="4,0,8,0" />
  </Style>

  <!-- Кнопки: объёмные, как TButton/TBitBtn -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="12,3" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="{StaticResource ButtonFace}" />
    <Setter Property="BorderBrush" Value="#8A8778" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ButtonFaceHover}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FaceDark}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentDark}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Face}" />
    <Setter Property="BorderBrush" Value="{StaticResource GridLine}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentDark}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentDark}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Link}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource AccentDark}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33FFFFFF" />
    <Setter Property="BorderBrush" Value="#88FFFFFF" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#55000000" />
  </Style>

  <!-- Кнопки модулей в панели навигации -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="0,0,1,0" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ButtonFaceHover}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
  </Style>
  <Style Selector="Button.nav.current">
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.navglyph">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Border.navglyph > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Меню -->
  <Style Selector="Menu">
    <Setter Property="Background" Value="{StaticResource Face}" />
    <Setter Property="Height" Value="24" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>

  <!-- Панели-группы -->
  <Style Selector="Border.card">
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource FaceLight}" />
    <Setter Property="Padding" Value="8,6,8,8" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="HeaderedContentControl.group">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" Background="{StaticResource FaceLight}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderFace}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="0,0,0,1" Padding="8,3">
              <ContentPresenter Content="{TemplateBinding Header}" FontWeight="Bold"
                                Foreground="{StaticResource Caption}" />
            </Border>
            <ContentPresenter Content="{TemplateBinding Content}" Padding="8,6,8,8" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{StaticResource FaceDark}" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Border.filterbar">
    <Setter Property="Background" Value="{StaticResource FaceLight}" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,5" />
  </Style>
  <Style Selector="Border.filterbar TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.actionbar">
    <Setter Property="Background" Value="{StaticResource Face}" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Border.desk">
    <Setter Property="Background" Value="{StaticResource Desk}" />
  </Style>

  <!-- Цветные плашки -->
  <Style Selector="Border.warn, Border.debt, Border.ok, Border.info, Border.off">
    <Setter Property="BorderThickness" Value="1,1,1,1" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="Border.warn"><Setter Property="Background" Value="{StaticResource WarnBg}" /><Setter Property="BorderBrush" Value="{StaticResource WarnBd}" /></Style>
  <Style Selector="Border.warn TextBlock"><Setter Property="Foreground" Value="{StaticResource WarnInk}" /></Style>
  <Style Selector="Border.debt"><Setter Property="Background" Value="{StaticResource DebtBg}" /><Setter Property="BorderBrush" Value="{StaticResource DebtBd}" /></Style>
  <Style Selector="Border.debt TextBlock"><Setter Property="Foreground" Value="{StaticResource DebtInk}" /></Style>
  <Style Selector="Border.ok"><Setter Property="Background" Value="{StaticResource OkBg}" /><Setter Property="BorderBrush" Value="{StaticResource OkBd}" /></Style>
  <Style Selector="Border.ok TextBlock"><Setter Property="Foreground" Value="{StaticResource OkInk}" /></Style>
  <Style Selector="Border.info"><Setter Property="Background" Value="{StaticResource InfoBg}" /><Setter Property="BorderBrush" Value="{StaticResource InfoBd}" /></Style>
  <Style Selector="Border.info TextBlock"><Setter Property="Foreground" Value="{StaticResource InfoInk}" /></Style>
  <Style Selector="Border.off"><Setter Property="Background" Value="{StaticResource OffBg}" /><Setter Property="BorderBrush" Value="{StaticResource Edge}" /></Style>
  <Style Selector="Border.off TextBlock"><Setter Property="Foreground" Value="{StaticResource OffInk}" /></Style>
  <Style Selector="Border.badge">
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Таблицы: плотные строки, серые линии, синяя выделенная строка -->
  <Style Selector="DataGrid">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="GridLinesVisibility" Value="All" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="RowHeight" Value="22" />
    <Setter Property="ColumnHeaderHeight" Value="24" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="SeparatorBrush" Value="{StaticResource Edge}" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="DataGridCell TextBlock">
    <Setter Property="Margin" Value="6,0" />
  </Style>
  <Style Selector="DataGridRow:selected">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="DataGridRow.warn"><Setter Property="Background" Value="{StaticResource WarnBg}" /></Style>
  <Style Selector="DataGridRow.debt"><Setter Property="Background" Value="{StaticResource DebtBg}" /></Style>
  <Style Selector="DataGridRow.ok"><Setter Property="Background" Value="{StaticResource OkBg}" /></Style>
  <Style Selector="DataGridRow.info"><Setter Property="Background" Value="{StaticResource InfoBg}" /></Style>
  <Style Selector="DataGridRow.off"><Setter Property="Foreground" Value="{StaticResource OffInk}" /></Style>

  <!-- Списки -->
  <Style Selector="ListBox">
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource Field}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>

  <!-- Вкладки: как закладки старых форм -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="Background" Value="{StaticResource FaceDark}" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="{StaticResource FaceLight}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>

  <!-- Строка состояния: «утопленные» ячейки -->
  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{StaticResource Face}" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="Border.statuscell">
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource FaceLight}" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Margin" Value="0,0,2,0" />
  </Style>
  <Style Selector="Border.statuscell TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
