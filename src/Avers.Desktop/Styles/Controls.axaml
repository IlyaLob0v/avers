<!--
  Общие стили Аверса. Классы, которыми пользуются экраны:

  Панели     HeaderedContentControl.group Header="…" — белая панель с заголовком и разделителем (основной вид)
             Border.card — белая панель без заголовка; TextBlock.legend внутри — подзаголовок
             Border.inset — серый вспомогательный блок внутри панели (назначенная роль на входе)
             Border.toolbar — строка кнопок экрана под заголовком; Border.filterbar — полоса фильтров
             Border.actionbar — нижняя полоса с кнопками окна (ОК / Отмена справа)
  Пометки    Border.warn / .debt / .ok / .info / .off — цветная плашка-предупреждение
             Border.badge + .warn/.debt/.ok/.info/.off — метка-«таблетка» в строке
             Border.swatch + .warn/.debt/.ok/.info/.off — квадратик в легенде цветов
             строки таблицы: ctl:GridTone.Enabled="True" на DataGrid, строка реализует IRowTone (Controls/GridTone.cs)
  Текст      TextBlock.h1 — заголовок экрана, .crumb — модуль перед заголовком, .legend — подзаголовок в панели,
             .label — подпись поля, .value — значение для чтения, .money — сумма (вправо),
             .total — крупная сумма (+ .ok зелёная, .debt красная), .hint — пояснение, .section — подпись раздела
             прописными, .link — ссылка
  Кнопки     Button — белая с рамкой; Button.primary — главное действие экрана (синяя), Button.link — переход
             «провалиться» (договор, квартира), Button.tile — плитка модуля на рабочем столе
  Поля       TextBox.cell, ComboBox.cell — поле в форме; DatePicker и CalendarDatePicker той же высоты;
             TextBox.debt — поле суммы долга (красное, ставить классом по признаку HasDebt)
  Каркас     Border.topbar, Menu.topmenu, Button.ontop, TextBlock.ontop (Run.strong — выделенная часть),
             TextBlock.brand — тёмная шапка окна; Border.modbar, Button.mod (+ .current),
             Border.navglyph — полоса модулей; Border.screenhead — строка заголовка экрана; Border.statusbar — строка
             состояния; Border.tileglyph (+ .stub) — значок плитки рабочего стола
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Окно и текст -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="{StaticResource Face}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.crumb">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.legend">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.7" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="Margin" Value="0,2,8,2" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.money">
    <Setter Property="TextAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBlock.total">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.total.ok">
    <Setter Property="Foreground" Value="{StaticResource OkInk}" />
  </Style>
  <Style Selector="TextBlock.total.debt">
    <Setter Property="Foreground" Value="{StaticResource DebtInk}" />
  </Style>
  <Style Selector="TextBlock.link">
    <Setter Property="Foreground" Value="{StaticResource Link}" />
    <Setter Property="TextDecorations" Value="Underline" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Поля ввода: белые, рамка #B9C1CD, скругление 3, синяя рамка в фокусе -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.cell">
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="TextBox:readonly">
    <Setter Property="Background" Value="{StaticResource FieldReadOnly}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="TextBox:readonly:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource FieldReadOnly}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:readonly:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource FieldReadOnly}" />
  </Style>
  <Style Selector="TextBox.debt">
    <Setter Property="Background" Value="{StaticResource DebtBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource DebtBd}" />
    <Setter Property="Foreground" Value="{StaticResource DebtInk}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBox.debt:pointerover /template/ Border#PART_BorderElement, TextBox.debt:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource DebtBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource DebtBd}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="ComboBox.cell">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="CalendarDatePicker, DatePicker">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="CalendarDatePicker">
    <Setter Property="SelectedDateFormat" Value="Custom" />
    <Setter Property="CustomDateFormatString" Value="dd.MM.yyyy" />
    <Setter Property="Watermark" Value="дд.мм.гггг" />
  </Style>
  <Style Selector="CheckBox, RadioButton">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="6,0,10,0" />
  </Style>

  <!-- Кнопки: белые с рамкой, высота 28; главная — синяя -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FaceLight}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FaceDark}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FaceLight}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
    <Setter Property="Foreground" Value="{StaticResource InkDisabled}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHover}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentDark}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentDark}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FaceLight}" />
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
    <Setter Property="Foreground" Value="{StaticResource InkDisabled}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Link}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource AccentDark}" />
  </Style>

  <!-- Плитки модулей на рабочем столе -->
  <Style Selector="Button.tile">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Margin" Value="0,0,12,12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Border.tileglyph">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.tileglyph > TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource AccentSoftInk}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tileglyph.stub">
    <Setter Property="Background" Value="{StaticResource OffBg}" />
  </Style>
  <Style Selector="Border.tileglyph.stub > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OffInk}" />
  </Style>

  <!-- Шапка окна: тёмно-синяя полоса с маркой, меню, пользователем и кнопкой «Выйти» -->
  <Style Selector="Border.topbar">
    <Setter Property="Background" Value="{StaticResource TopBar}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="TextBlock.ontop">
    <Setter Property="Foreground" Value="{StaticResource TopBarInk}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.ontop Run.strong">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.brand">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ontop">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="{StaticResource TopBar}" />
    <Setter Property="BorderBrush" Value="{StaticResource TopBarEdge}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="Button.ontop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TopBarHover}" />
    <Setter Property="BorderBrush" Value="{StaticResource TopBarInk}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="Button.ontop:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentDark}" />
  </Style>

  <!-- Меню -->
  <Style Selector="Menu.topmenu">
    <Setter Property="Background" Value="{StaticResource TopBar}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Menu.topmenu > MenuItem">
    <Setter Property="Foreground" Value="{StaticResource TopBarInk}" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Menu.topmenu > MenuItem:pointerover /template/ Border#PART_LayoutRoot, Menu.topmenu > MenuItem:selected /template/ Border#PART_LayoutRoot, Menu.topmenu > MenuItem:open /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource TopBarHover}" />
  </Style>
  <Style Selector="Menu.topmenu > MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter, Menu.topmenu > MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter, Menu.topmenu > MenuItem:open /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="MenuItem MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="MenuItem MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>

  <!-- Полоса модулей: белая, у текущего синяя черта снизу и залитый значок -->
  <Style Selector="Border.modbar">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Button.mod">
    <Setter Property="Height" Value="39" />
    <Setter Property="Padding" Value="8,2,8,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Panel}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="Button.mod:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FaceLight}" />
    <Setter Property="BorderBrush" Value="{StaticResource FaceLight}" />
  </Style>
  <Style Selector="Button.mod.current">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.mod.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.mod Path">
    <Setter Property="Stroke" Value="{StaticResource Muted}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Button.mod.current Path">
    <Setter Property="Stroke" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Border.navglyph">
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="Border.navglyph > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentSoftInk}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.mod.current Border.navglyph">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.mod.current Border.navglyph > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>

  <!-- Строка заголовка экрана и строка состояния -->
  <Style Selector="Border.screenhead">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="16,0" />
  </Style>
  <Style Selector="Border.statusbar">
    <Setter Property="Height" Value="24" />
    <Setter Property="Background" Value="{StaticResource FaceDark}" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="Border.statusbar TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Панели -->
  <Style Selector="Border.card">
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,8,12,10" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{StaticResource FaceLight}" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeLight}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="HeaderedContentControl.group">
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Padding" Value="12,8,12,10" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="4" Background="{StaticResource Panel}">
          <DockPanel>
            <Border DockPanel.Dock="Top" MinHeight="34" Padding="12,4" BorderBrush="{StaticResource EdgeLight}" BorderThickness="0,0,0,1">
              <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </Border>
            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Padding" Value="16,0,16,10" />
  </Style>
  <Style Selector="Border.filterbar">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.filterbar TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.actionbar">
    <Setter Property="BorderBrush" Value="{StaticResource EdgeLight}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- Цветные плашки -->
  <Style Selector="Border.warn, Border.debt, Border.ok, Border.info, Border.off">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="Border.warn"><Setter Property="Background" Value="{StaticResource WarnBg}" /><Setter Property="BorderBrush" Value="{StaticResource WarnBd}" /></Style>
  <Style Selector="Border.warn TextBlock"><Setter Property="Foreground" Value="{StaticResource WarnInk}" /></Style>
  <Style Selector="Border.debt"><Setter Property="Background" Value="{StaticResource DebtBg}" /><Setter Property="BorderBrush" Value="{StaticResource DebtBd}" /></Style>
  <Style Selector="Border.debt TextBlock"><Setter Property="Foreground" Value="{StaticResource DebtInk}" /></Style>
  <Style Selector="Border.ok"><Setter Property="Background" Value="{StaticResource OkBg}" /><Setter Property="BorderBrush" Value="{StaticResource OkBd}" /></Style>
  <Style Selector="Border.ok TextBlock"><Setter Property="Foreground" Value="{StaticResource OkInk}" /></Style>
  <Style Selector="Border.info"><Setter Property="Background" Value="{StaticResource InfoBg}" /><Setter Property="BorderBrush" Value="{StaticResource InfoBd}" /></Style>
  <Style Selector="Border.info TextBlock"><Setter Property="Foreground" Value="{StaticResource InfoInk}" /></Style>
  <Style Selector="Border.off"><Setter Property="Background" Value="{StaticResource OffBg}" /><Setter Property="BorderBrush" Value="{StaticResource OffBd}" /></Style>
  <Style Selector="Border.off TextBlock"><Setter Property="Foreground" Value="{StaticResource OffInk}" /></Style>
  <Style Selector="Border.badge">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.swatch">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Таблицы: строки 26, серая шапка, только горизонтальные линии, синяя выделенная строка -->
  <Style Selector="DataGrid">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="RowHeight" Value="26" />
    <Setter Property="ColumnHeaderHeight" Value="28" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="Background" Value="{StaticResource FaceLight}" />
    <Setter Property="SeparatorBrush" Value="{StaticResource EdgeLight}" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="DataGridCell TextBlock">
    <Setter Property="Margin" Value="8,0" />
  </Style>
  <Style Selector="DataGridRow.warn"><Setter Property="Background" Value="{StaticResource WarnBg}" /></Style>
  <Style Selector="DataGridRow.debt"><Setter Property="Background" Value="{StaticResource DebtBg}" /></Style>
  <Style Selector="DataGridRow.ok"><Setter Property="Background" Value="{StaticResource OkBg}" /></Style>
  <Style Selector="DataGridRow.info"><Setter Property="Background" Value="{StaticResource InfoBg}" /></Style>
  <Style Selector="DataGridRow.off">
    <Setter Property="Background" Value="{StaticResource OffBg}" />
    <Setter Property="Foreground" Value="{StaticResource OffInk}" />
  </Style>
  <Style Selector="DataGridRow:selected">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>

  <!-- Списки -->
  <Style Selector="ListBox">
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{StaticResource Field}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>

  <!-- Вкладки -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
</Styles>
