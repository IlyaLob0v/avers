<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             xmlns:d="using:Avers.Domain"
             xmlns:ctl="using:Avers.Desktop.Controls"
             x:Class="Avers.Desktop.Views.AbonView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.form TextBox">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <StackPanel Orientation="Horizontal">
        <Button Content="Улицы…" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Phonebook}" />
        <Button Content="Данные по дому" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Anten}" />
        <Button Content="Карточка" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Subscriber}" />
        <Button Content="Печать л/с" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Print}" />
        <TextBlock Text="Искать по:" VerticalAlignment="Center" Margin="16,0,8,0" Classes="hint" />
        <RadioButton Content="Адресу" IsChecked="{Binding SearchMode, Mode=OneWay, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:SearchMode.Address}}" Command="{Binding SetSearchCommand}" CommandParameter="{x:Static d:SearchMode.Address}" />
        <RadioButton Content="ПЖРЭУ" IsChecked="{Binding SearchMode, Mode=OneWay, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:SearchMode.Pzhreu}}" Command="{Binding SetSearchCommand}" CommandParameter="{x:Static d:SearchMode.Pzhreu}" />
        <RadioButton Content="Лиц. счёту" IsChecked="{Binding SearchMode, Mode=OneWay, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:SearchMode.Account}}" Command="{Binding SetSearchCommand}" CommandParameter="{x:Static d:SearchMode.Account}" />
        <RadioButton Content="Вн. коду" IsChecked="{Binding SearchMode, Mode=OneWay, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:SearchMode.InnerCode}}" Command="{Binding SetSearchCommand}" CommandParameter="{x:Static d:SearchMode.InnerCode}" />
        <RadioButton Content="Фамилии" IsChecked="{Binding SearchMode, Mode=OneWay, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:SearchMode.Surname}}" Command="{Binding SetSearchCommand}" CommandParameter="{x:Static d:SearchMode.Surname}" />
      </StackPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="16,0,16,2">
        <Grid ColumnDefinitions="320,*">
          <StackPanel Margin="0,0,10,0">
            <HeaderedContentControl Classes="group" Header="Абонент">
              <Grid Classes="form" ColumnDefinitions="112,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Classes="label" Text="ФИО полностью" />
                <TextBox Grid.Column="1" Text="{Binding SelectedSubscriber.FullName}" IsReadOnly="True" />
                <TextBlock Grid.Row="1" Classes="label" Text="Телефон" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSubscriber.Phone}" />
                <TextBlock Grid.Row="2" Classes="label" Text="Улица" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSubscriber.House.Street.Name}" IsReadOnly="True" />
                <TextBlock Grid.Row="3" Classes="label" Text="Дом / секц / кв" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HouseAptLine, Mode=OneWay}" IsReadOnly="True" />
                <TextBlock Grid.Row="4" Classes="label" Text="Вн. код" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSubscriber.InnerCode}" />
                <TextBlock Grid.Row="5" Classes="label" Text="Лиц. счёт" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedSubscriber.Account}" />
                <TextBlock Grid.Row="6" Classes="label" Text="Индекс ПЖРУ" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SelectedSubscriber.PzhreuIndex}" />
                <TextBlock Grid.Row="7" Classes="label" Text="Счёт ПЖРЭУ" />
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SelectedSubscriber.PzhreuAccount}" />
                <TextBlock Grid.Row="8" Classes="label" Text="Договор" />
                <Button Grid.Row="8" Grid.Column="1" Classes="link" Margin="0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        ToolTip.Tip="Открыть договор" Command="{Binding OpenContractCommand}">
                  <TextBlock Text="{Binding CardContractShort}" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Grid.Row="9" Classes="label" Text="Льгота" />
                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding SelectedSubscriber.Benefit, Mode=OneWay}" IsReadOnly="True" />
                <TextBlock Grid.Row="10" Classes="label" Text="Расчёт с" />
                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding SelectedSubscriber.SettlementFrom}" IsReadOnly="True" />
              </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Classes="group" Header="Поиск">
              <StackPanel>
                <Grid ColumnDefinitions="*,64,48,48">
                  <TextBox Classes="cell" Margin="0,0,4,0" Text="{Binding FindStreet}" PlaceholderText="Улица" />
                  <TextBox Grid.Column="1" Classes="cell" Margin="0,0,4,0" Text="{Binding FindHouse}" PlaceholderText="Дом" />
                  <TextBox Grid.Column="2" Classes="cell" Margin="0,0,4,0" Text="{Binding FindSection}" PlaceholderText="Секц" />
                  <TextBox Grid.Column="3" Classes="cell" Margin="0" Text="{Binding FindApartment}" PlaceholderText="Кв" />
                </Grid>
                <TextBox Classes="cell" Margin="0,4,0,0" Text="{Binding FindQuery}" PlaceholderText="ПЖРЭУ / лиц. счёт / вн. код / фамилия" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Classes="primary" Content="Найти" Command="{Binding FindCommand}" />
                  <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="200"
                             Text="Улица · Дом · Секция · Кв. · Фамилия" />
                </StackPanel>
              </StackPanel>
            </HeaderedContentControl>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <Border Classes="warn" IsVisible="{Binding HasFault}">
              <TextBlock Text="{Binding FaultBanner}" TextWrapping="Wrap" />
            </Border>
            <Border Classes.card="{Binding !IsPaymentLate}" Classes.warn="{Binding IsPaymentLate}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding LastPaymentLine}" />
                <TextBlock Classes="hint" Text="{Binding LastPaymentAgo}" />
              </StackPanel>
            </Border>
            <HeaderedContentControl Classes="group" Header="{Binding PaymentsCaption}">
              <StackPanel>
                <DataGrid ItemsSource="{Binding PaymentRows}" AutoGenerateColumns="False" Height="168" IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="" Binding="{Binding Title}" Width="84" />
                    <DataGridTextColumn Header="Янв" Binding="{Binding Jan}" Width="*" MinWidth="62" />
                    <DataGridTextColumn Header="Фев" Binding="{Binding Feb}" Width="*" MinWidth="62" />
                    <DataGridTextColumn Header="Мар" Binding="{Binding Mar}" Width="*" MinWidth="62" />
                    <DataGridTextColumn Header="Апр" Binding="{Binding Apr}" Width="*" MinWidth="62" />
                    <DataGridTextColumn Header="Май" Binding="{Binding May}" Width="*" MinWidth="62" />
                    <DataGridTextColumn Header="Июн" Binding="{Binding Jun}" Width="*" MinWidth="62" />
                    <DataGridTextColumn Header="Июл" Binding="{Binding Jul}" Width="*" MinWidth="62" />
                    <DataGridTextColumn Header="Авг" Binding="{Binding Aug}" Width="*" MinWidth="62" />
                    <DataGridTextColumn Header="Сен" Binding="{Binding Sep}" Width="*" MinWidth="62" />
                    <DataGridTextColumn Header="Окт" Binding="{Binding Oct}" Width="*" MinWidth="62" />
                    <DataGridTextColumn Header="Ноя" Binding="{Binding Nov}" Width="*" MinWidth="62" />
                    <DataGridTextColumn Header="Дек" Binding="{Binding Dec}" Width="*" MinWidth="62" />
                  </DataGrid.Columns>
                </DataGrid>
                <Grid ColumnDefinitions="*,*,*,*" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock Classes="hint" Text="Всего должен" />
                    <TextBlock Classes="total" Text="{Binding ChargedText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="hint" Text="Оплачено" />
                    <TextBlock Classes="total ok" Text="{Binding PaidText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Classes="hint" Text="Долг 26" />
                    <TextBlock Classes="total" Classes.debt="{Binding HasDebt}" Text="{Binding DebtText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="3">
                    <TextBlock Classes="hint" Text="К внесению" />
                    <TextBox Text="{Binding ToPayText, Mode=OneWay}" IsReadOnly="True" FontSize="15" FontWeight="SemiBold" MinHeight="30" />
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Classes="primary" Content="Внести оплату" Command="{Binding RecordPaymentCommand}" />
                  <Button Content="Печать лицевого счёта" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Print}" />
                  <Button Content="Квитанция" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Print}" />
                  <TextBlock Classes="hint" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"
                             Text="Окно «Подтверждение» не показывается от 1000,00 ₽. ФИО на печати полностью." />
                </StackPanel>
              </StackPanel>
            </HeaderedContentControl>
          </StackPanel>
        </Grid>
        <HeaderedContentControl Classes="group" Header="Улицы и дома · индекс ПЖРУ и счета">
          <StackPanel>
            <Grid x:Name="StreetsAndHouses" ColumnDefinitions="220,*" Height="190">
              <ListBox Classes="streets" ItemsSource="{Binding Streets}" SelectedItem="{Binding SelectedStreet}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="d:Street">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <DataGrid Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding HousesOnStreet}"
                        SelectedItem="{Binding SelectedHouse}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Дом" Binding="{Binding Number}" Width="80" />
                  <DataGridTextColumn Header="Индекс" Binding="{Binding PzhreuIndex}" Width="90" />
                  <DataGridTextColumn Header="Счёт ПЖРЭУ" Binding="{Binding PzhreuAccount}" Width="120" />
                  <DataGridTextColumn Header="Кв." Binding="{Binding Apartments}" Width="70" />
                  <DataGridTextColumn Header="Эт." Binding="{Binding Floors}" Width="70" />
                  <DataGridTextColumn Header="Под." Binding="{Binding Entrances}" Width="70" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
            <TextBlock Classes="hint" Margin="0,6,0,0" Text="Выберите улицу слева — справа дома этой улицы, индекс ПЖРУ и счёт." />
          </StackPanel>
        </HeaderedContentControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
