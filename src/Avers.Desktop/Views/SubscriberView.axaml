<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             xmlns:d="using:Avers.Domain"
             x:Class="Avers.Desktop.Views.SubscriberView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.form > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Margin" Value="0,2,8,2" />
    </Style>
    <Style Selector="Grid.form > TextBox, Grid.form > ComboBox">
      <Setter Property="Margin" Value="0,2" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="16,0,16,2">
      <!-- Шапка: фамилия крупно, адрес квартиры, лицевой счёт -->
      <Border Classes="card" Padding="16,10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding CardSurname}" />
              <TextBlock FontSize="16" VerticalAlignment="Bottom" Margin="0,0,0,2" Text="{Binding CardNameRest}" />
            </StackPanel>
            <TextBlock Margin="0,2,0,0" Text="{Binding CardAddress}" />
            <TextBlock Classes="hint" Margin="0,2,0,0" Text="{Binding CardOrganization, StringFormat='Обслуживающая организация (бывш. «домовладелец»): {0}'}" />
            <TextBlock Classes="hint" Text="{Binding SelectedSubscriber.Phone, StringFormat='Телефон: {0}'}" />
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right">
            <TextBlock Classes="hint" HorizontalAlignment="Right" Text="Лицевой счёт" />
            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Caption}" HorizontalAlignment="Right" Text="{Binding CardAccount}" />
            <TextBlock Classes="hint" HorizontalAlignment="Right" Text="{Binding SelectedSubscriber.InnerCode, StringFormat='вн. код {0}'}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="warn" IsVisible="{Binding HasFault}">
        <TextBlock Text="{Binding FaultBanner}" TextWrapping="Wrap" />
      </Border>

      <!-- Последняя оплата: общая жёлтая плашка warn, если без оплаты дольше порога -->
      <Border Classes.card="{Binding !IsPaymentLate}" Classes.warn="{Binding IsPaymentLate}" Padding="16,8">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding LastPaymentLine}" />
            <TextBlock Classes="hint" Text="{Binding PaymentWarningHint}" />
          </StackPanel>
          <Border Grid.Column="1" Classes="badge" Classes.ok="{Binding !IsPaymentLate}" Classes.warn="{Binding IsPaymentLate}" Margin="12,0,0,0">
            <TextBlock Text="{Binding LastPaymentAgo}" />
          </Border>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,*">
        <!-- Договор -->
        <HeaderedContentControl Classes="group" Margin="0,0,5,10" Header="Договор на техобслуживание">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding CardContractLine}" />
            <Grid Classes="form" ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto">
              <TextBlock Text="Номер договора" />
              <TextBox Grid.Column="1" Classes="cell" Text="{Binding EditContractNumber}" IsReadOnly="{Binding !CanEditCard}" />
              <TextBlock Grid.Row="1" Text="Заключён" />
              <TextBox Grid.Row="1" Grid.Column="1" Classes="cell" Text="{Binding EditContractDate}" PlaceholderText="дд.мм.гггг" IsReadOnly="{Binding !CanEditCard}" />
              <TextBlock Grid.Row="2" Text="Расторгнут" />
              <TextBox Grid.Row="2" Grid.Column="1" Classes="cell" Text="{Binding EditContractTerminated}" PlaceholderText="действует" IsReadOnly="{Binding !CanEditCard}" />
              <TextBlock Grid.Row="3" Text="С кем заключён" />
              <TextBox Grid.Row="3" Grid.Column="1" Classes="cell" Text="{Binding EditContractHolder}" PlaceholderText="пусто — с самим абонентом" IsReadOnly="{Binding !CanEditCard}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Classes="link" VerticalAlignment="Center" Margin="0,0,16,0" Content="Открыть договор →" Command="{Binding OpenContractCommand}" />
              <Button Classes="primary" Content="Сохранить" Command="{Binding SaveCardCommand}" IsVisible="{Binding CanEditCard}" />
            </StackPanel>
          </StackPanel>
        </HeaderedContentControl>

        <!-- Абонент и примечание -->
        <HeaderedContentControl Grid.Column="1" Classes="group" Margin="5,0,0,10" Header="Квартира и абонент">
          <StackPanel>
            <Grid Classes="form" ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Text="ФИО полностью" />
              <TextBox Grid.Column="1" Classes="cell" Text="{Binding SelectedSubscriber.FullName, Mode=OneWay}" IsReadOnly="True" />
              <TextBlock Grid.Row="1" Text="Индекс / счёт ПЖРЭУ" />
              <TextBox Grid.Row="1" Grid.Column="1" Classes="cell" IsReadOnly="True"
                       Text="{Binding SelectedSubscriber.PzhreuAccount, Mode=OneWay}" />
              <TextBlock Grid.Row="2" Text="Льгота" />
              <TextBox Grid.Row="2" Grid.Column="1" Classes="cell" Text="{Binding SelectedSubscriber.Benefit, Mode=OneWay}" IsReadOnly="True" />
              <TextBlock Grid.Row="3" Text="Расчёт с" />
              <TextBox Grid.Row="3" Grid.Column="1" Classes="cell" Text="{Binding SelectedSubscriber.SettlementFrom, Mode=OneWay}" IsReadOnly="True" />
              <TextBlock Grid.Row="4" Text="Долг" />
              <TextBox Grid.Row="4" Grid.Column="1" Classes="cell" Classes.debt="{Binding HasDebt}" IsReadOnly="True" Text="{Binding DebtText, Mode=OneWay}" />
              <TextBlock Grid.Row="5" Text="Организация, тел." />
              <TextBox Grid.Row="5" Grid.Column="1" Classes="cell" IsReadOnly="True" Text="{Binding CardOrganizationPhones, Mode=OneWay}" />
            </Grid>
            <TextBlock Classes="legend" Margin="0,8,0,4" Text="Примечание" />
            <TextBox Classes="cell" MinHeight="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     Text="{Binding EditNotes}" IsReadOnly="{Binding !CanEditCard}" />
            <CheckBox Margin="0,6,0,0" IsChecked="{Binding SelectedSubscriber.PrintAccountWithPayDate}" Content="Печатать лицевой счёт с датой оплаты" />
          </StackPanel>
        </HeaderedContentControl>
      </Grid>

      <!-- Оплаты: кто внёс и кто оплатил -->
      <HeaderedContentControl Classes="group">
        <HeaderedContentControl.Header>
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="primary" Margin="0" Content="Внести оплату" Command="{Binding RecordPaymentCommand}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock VerticalAlignment="Center" Text="Оплаты за" />
              <ComboBox MinWidth="90" FontWeight="Normal" ItemsSource="{Binding CardPaymentYears}" SelectedItem="{Binding CardPaymentYear}" />
            </StackPanel>
          </DockPanel>
        </HeaderedContentControl.Header>
        <DataGrid ItemsSource="{Binding CardPayments}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="330">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Месяц" Binding="{Binding Month}" Width="100" />
            <DataGridTextColumn Header="Тариф" Binding="{Binding Tariff}" Width="90" />
            <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="90" />
            <DataGridTextColumn Header="Дата оплаты" Binding="{Binding PaidAt}" Width="125" />
            <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="110" />
            <DataGridTextColumn Header="Внёс (сотрудник)" Binding="{Binding RecordedBy}" Width="170" />
            <DataGridTextColumn Header="Оплатил" Binding="{Binding PayerName}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </HeaderedContentControl>

      <!-- Заявки по квартире -->
      <HeaderedContentControl Classes="group">
        <HeaderedContentControl.Header>
          <DockPanel>
            <Button DockPanel.Dock="Right" Margin="0" FontWeight="Normal" Content="Принять заявку" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Disp}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock VerticalAlignment="Center" Text="Заявки по квартире за" />
              <ComboBox MinWidth="110" FontWeight="Normal" ItemsSource="{Binding CardTicketYears}" SelectedItem="{Binding CardTicketYear}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:YearOption">
                    <TextBlock Text="{Binding Title}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </DockPanel>
        </HeaderedContentControl.Header>
        <DataGrid ItemsSource="{Binding ApartmentTicketRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260">
          <DataGrid.Columns>
            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="60" />
            <DataGridTextColumn Header="Дата" Binding="{Binding Date, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}" Width="110" />
            <DataGridTextColumn Header="Неисправность" Binding="{Binding Fault}" Width="2*" />
            <DataGridTextColumn Header="Радиомеханик" Binding="{Binding Mechanic}" Width="150" />
            <DataGridTextColumn Header="Работа" Binding="{Binding WorkDone}" Width="2*" />
            <DataGridTextColumn Header="Вып." Binding="{Binding StatusLabel}" Width="70" />
          </DataGrid.Columns>
        </DataGrid>
      </HeaderedContentControl>

      <!-- Порог подсветки: администратор и начальник АДС -->
      <Border Classes="card" IsVisible="{Binding CanEditSettings}">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="Подсвечивать жёлтым, если без оплаты" />
            <NumericUpDown Width="110" Minimum="1" Maximum="36" Increment="1" FormatString="0" Value="{Binding EditWarningMonths}" />
            <TextBlock VerticalAlignment="Center" Text="мес. и больше (для всех рабочих мест)" />
            <Button Content="Применить" Command="{Binding SavePaymentWarningCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="Начисления на год всем абонентам с действующим договором, по последнему тарифу" />
            <Button Content="{Binding OpenYearTitle}" Command="{Binding OpenYearCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
