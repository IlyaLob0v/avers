<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             x:Class="Avers.Desktop.Views.PrDublView"
             x:DataType="vm:MainViewModel">
  <StackPanel Margin="16,0,16,12">
    <Border Classes="card" Padding="12,6,4,8">
      <Grid ColumnDefinitions="*,*,*,*">
        <StackPanel Margin="0,0,8,0"><TextBlock Classes="hint" Text="Вн. код"/><TextBox Classes="cell" Text="{Binding SelectedSubscriber.InnerCode, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Classes="hint" Text="Индекс ПЖРУ"/><TextBox Classes="cell" Text="{Binding SelectedSubscriber.PzhreuIndex, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Classes="hint" Text="Лиц. счёт"/><TextBox Classes="cell" Text="{Binding SelectedSubscriber.Account, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
        <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Classes="hint" Text="Период"/><TextBox Classes="cell" Text="За июль 2026" IsReadOnly="True"/></StackPanel>
      </Grid>
    </Border>
    <DataGrid Height="300" ItemsSource="{Binding Receipts}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Вн. код" Binding="{Binding InnerCode}" Width="100" />
        <DataGridTextColumn Header="Индекс" Binding="{Binding PzhreuIndex}" Width="90" />
        <DataGridTextColumn Header="Лиц. счёт" Binding="{Binding Account}" Width="110" />
        <DataGridTextColumn Header="На момент" Binding="{Binding Moment}" Width="120" />
        <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="90" />
        <DataGridTextColumn Header="Оплачено" Binding="{Binding Paid}" Width="100" />
        <DataGridTextColumn Header="N_OS" Binding="{Binding NOs}" Width="80" />
        <DataGridTextColumn Header="N_KASS" Binding="{Binding NKass}" Width="90" />
        <DataGridTextColumn Header="N_OPER" Binding="{Binding NOper}" Width="90" />
        <DataGridTextColumn Header="N_КВИТ" Binding="{Binding NKvit}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </StackPanel>
</UserControl>
