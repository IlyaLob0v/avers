<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             x:Class="Avers.Desktop.Views.PrDublView"
             x:DataType="vm:ReceiptsViewModel">
  <StackPanel Margin="16,0,16,12">
    <Border Classes="card" Padding="12,6,4,8">
      <StackPanel>
        <Grid ColumnDefinitions="*,*,*,*,Auto">
          <StackPanel Margin="0,0,8,0"><TextBlock Classes="hint" Text="Лиц. счёт"/>
            <TextBox Classes="cell" Text="{Binding ReceiptAccount}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding FindReceiptsCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Classes="hint" Text="Период"/>
            <ComboBox Classes="cell" HorizontalAlignment="Stretch" ItemsSource="{Binding ReceiptPeriods}" SelectedItem="{Binding SelectedReceiptPeriod}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ReceiptPeriod">
                  <TextBlock Text="{Binding Title}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Classes="hint" Text="Вн. код"/><TextBox Classes="cell" Text="{Binding Shell.SelectedSubscriber.InnerCode, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
          <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Classes="hint" Text="Индекс ПЖРУ"/><TextBox Classes="cell" Text="{Binding Shell.SelectedSubscriber.PzhreuIndex, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
          <Button Grid.Column="4" Classes="primary" VerticalAlignment="Bottom" Content="Найти" Command="{Binding FindReceiptsCommand}" />
        </Grid>
        <TextBlock Classes="hint" Margin="0,6,0,0" Text="{Binding ReceiptOwner}" />
      </StackPanel>
    </Border>
    <DataGrid Height="300" ItemsSource="{Binding Receipts}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Вн. код" Binding="{Binding InnerCode}" Width="100" />
        <DataGridTextColumn Header="Индекс" Binding="{Binding PzhreuIndex}" Width="90" />
        <DataGridTextColumn Header="Лиц. счёт" Binding="{Binding Account}" Width="110" />
        <DataGridTextColumn Header="На момент" Binding="{Binding Moment}" Width="120" />
        <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="90" />
        <DataGridTextColumn Header="Оплачено" Binding="{Binding Paid}" Width="100" />
        <DataGridTextColumn Header="N_OS" Binding="{Binding NOs}" Width="80" />
        <DataGridTextColumn Header="N_KASS" Binding="{Binding NKass}" Width="90" />
        <DataGridTextColumn Header="N_OPER" Binding="{Binding NOper}" Width="90" />
        <DataGridTextColumn Header="N_КВИТ" Binding="{Binding NKvit}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
    <Border Classes="card" Margin="0,10,0,0" Padding="12,8" IsVisible="{Binding Shell.CanEditSettings}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock VerticalAlignment="Center" Text="Файл начислений ОЭК (nachММГГГГ_an, Excel) за месяц" />
        <TextBox Classes="cell" Width="90" Text="{Binding OekMonth}" PlaceholderText="мм.гггг" />
        <Button Classes="primary" Content="Загрузить файл ОЭК" Command="{Binding ImportOekCommand}" />
      </StackPanel>
    </Border>
    <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap"
               Text="Единые квитанции делает ОЭК, мы в них услуга с кодом 38. Файл ОЭК: оплаты ложатся в месяц файла с источником «ОЭК», у квартиры запоминается л/с ОЭК; расхождения открываются в Excel." />
  </StackPanel>
</UserControl>
