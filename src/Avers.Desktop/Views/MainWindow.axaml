<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Avers.Desktop.ViewModels"
        xmlns:views="using:Avers.Desktop.Views"
        xmlns:d="using:Avers.Domain"
        xmlns:ctl="using:Avers.Desktop.Controls"
        x:Class="Avers.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/avers.ico"
        Width="1280" Height="840" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
  <Window.Resources>
    <ControlTheme x:Key="NavigationEntryTheme" TargetType="MenuItem"
                  BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:NavItem">
      <Setter Property="Header" Value="{Binding Title}" />
      <Setter Property="Command" Value="{Binding Go}" />
      <Setter Property="CommandParameter" Value="{Binding Module}" />
    </ControlTheme>
    <ControlTheme x:Key="NavigationGroupTheme" TargetType="MenuItem"
                  BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:NavGroup">
      <Setter Property="Header" Value="{Binding Title}" />
      <Setter Property="ItemsSource" Value="{Binding Items}" />
      <Setter Property="ItemContainerTheme" Value="{StaticResource NavigationEntryTheme}" />
    </ControlTheme>
  </Window.Resources>
  <Grid>
    <!-- Вход: белая карточка на тёмно-синем фоне -->
    <Panel IsVisible="{Binding ShowLogin}" Background="{StaticResource TopBar}">
      <Border Classes="card" Padding="0" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid ColumnDefinitions="Auto,420">
          <Border Width="270" Padding="16,20" Background="{StaticResource FaceLight}"
                  BorderBrush="{StaticResource EdgeLight}" BorderThickness="0,0,1,0" IsVisible="{Binding ShowDemoAccounts}">
            <StackPanel Spacing="12">
              <TextBlock Text="Учебные рабочие места" FontSize="16" FontWeight="SemiBold" />
              <ListBox ItemsSource="{x:Static vm:MainViewModel.DemoAccounts}" SelectedItem="{Binding SelectedDemoAccount}"
                       MaxHeight="420" Background="Transparent" BorderThickness="0"
                       AutomationProperties.Name="Выбор учебного пользователя">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DemoAccount">
                    <StackPanel Margin="4,5" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Login}" FontSize="12" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>
        <StackPanel Grid.Column="1">
          <Border Padding="24,20,24,16" BorderBrush="{StaticResource EdgeLight}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <Image Source="/Assets/logo-avers-servis.png" Height="72" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="АВЕРС" FontSize="22" FontWeight="SemiBold" LetterSpacing="1.3" Foreground="{StaticResource Caption}" />
                <TextBlock Classes="crumb" Margin="0,2,0,0" Text="Антенная служба · вход в систему" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Grid Margin="24,16" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Classes="label" Text="Пользователь" />
            <TextBox Grid.Column="1" Classes="cell" MinHeight="28" Text="{Binding LoginName}" IsVisible="{Binding EnterLoginName}" />
            <ComboBox Grid.Column="1" Classes="cell" MinHeight="28" ItemsSource="{Binding Users}" SelectedItem="{Binding LoginUser}"
                      IsVisible="{Binding ShowLocalAccounts}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="d:AppUser">
                  <TextBlock Text="{Binding Login}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Column="1" IsVisible="{Binding ShowDemoAccounts}" Spacing="2">
              <TextBlock Text="{Binding SelectedDemoAccount.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="hint" Text="{Binding SelectedDemoAccount.Login}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Classes="label" Text="Пароль" Margin="0,8,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Classes="cell" MinHeight="28" PasswordChar="•" Text="{Binding Password}" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Classes="label" Text="Подразделение" Margin="0,8,8,0" IsVisible="{Binding ShowLocalAccounts}" />
            <TextBox Grid.Row="2" Grid.Column="1" Classes="cell" MinHeight="28" IsReadOnly="True" IsVisible="{Binding ShowLocalAccounts}"
                     Text="{Binding LoginUser.Department}" Margin="0,8,0,0" />
          </Grid>
          <Border Classes="inset" Margin="24,0" IsVisible="{Binding ShowLocalAccounts}">
            <StackPanel>
              <TextBlock TextWrapping="Wrap">
                <Run Text="{Binding LoginUser.DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="·" />
                <Run Text="{Binding LoginRoleTitle, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="Права задаются при входе. Редактирование лицевого счёта — отдельное право. " />
            </StackPanel>
          </Border>
          <Border Classes="inset" Margin="24,0" IsVisible="{Binding ShowDemoAccounts}">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding SelectedDemoAccount.Description}" TextWrapping="Wrap" />
              <TextBlock Classes="hint" Text="Учебные данные · пароль всех учебных пользователей: avers" TextWrapping="Wrap" />
              <TextBlock Classes="hint" Text="После входа доступны разделы выбранной роли." TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <TextBlock Classes="hint" Margin="24,0" IsVisible="{Binding EnterLoginName}" TextWrapping="Wrap"
                     Text="Введите личный логин и пароль, выданные администратором. Доступные разделы определяются вашей должностью." />
          <Border Classes="debt" Margin="24,12,24,0" IsVisible="{Binding LoginError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding LoginError}" TextWrapping="Wrap" />
          </Border>
          <Border Classes="warn" Margin="24,12,24,0" IsVisible="{Binding ConnectionWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ConnectionWarning}" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16">
            <Button Content="Отмена" Command="{Binding LogoutCommand}" MinHeight="30" Padding="16,4" />
            <Button Classes="primary" Content="Войти" Command="{Binding LoginCommand}" IsDefault="True"
                    MinHeight="30" MinWidth="96" Padding="16,4" Margin="0" HorizontalContentAlignment="Center" />
          </StackPanel>
        </StackPanel>
        </Grid>
      </Border>
      <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,12" FontSize="12"
                 Foreground="{StaticResource TopBarDim}">
        <Run Text="{Binding ApplicationVersion, Mode=OneWay}" />
        <Run Text="{Binding StoreTitle, StringFormat='· {0}', Mode=OneWay}" />
        <Run Text="{Binding WorkDateText, StringFormat='· рабочая дата {0}', Mode=OneWay}" />
      </TextBlock>
    </Panel>

    <!-- Рабочее место -->
    <DockPanel IsVisible="{Binding ShowShell}">
      <!-- Шапка: марка, меню, рабочая дата, пользователь, выход -->
      <Border DockPanel.Dock="Top" Classes="topbar" IsEnabled="{Binding !HasPendingEditTransition}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" Margin="0,0,14,0">
            <Image Source="/Assets/logo-avers-servis.png" Height="26" VerticalAlignment="Center" />
            <TextBlock Classes="brand" Text="АВЕРС" />
          </StackPanel>
          <Button DockPanel.Dock="Right" Classes="ontop" Content="Выйти" Command="{Binding LogoutCommand}"
                  VerticalAlignment="Center" ToolTip.Tip="Сменить пользователя" />
          <TextBlock DockPanel.Dock="Right" Classes="ontop" Margin="14,0" MaxWidth="280" TextWrapping="Wrap">
            <Run Classes="strong" Text="{Binding User.DisplayName, Mode=OneWay}" />
            <Run Text="·" />
            <Run Text="{Binding UserRoleTitle, Mode=OneWay}" />
          </TextBlock>
          <TextBlock DockPanel.Dock="Right" Classes="ontop">
            <Run Text="Рабочая дата" />
            <Run Classes="strong" Text="{Binding WorkDateText, Mode=OneWay}" />
          </TextBlock>
          <Menu Classes="topmenu" HorizontalAlignment="Left">
            <MenuItem Header="_Файл">
              <MenuItem Header="Рабочий стол" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Desktop}" />
              <Separator />
              <MenuItem Header="Сменить пользователя" Command="{Binding LogoutCommand}" />
            </MenuItem>
            <MenuItem Header="_Модули" ItemsSource="{Binding NavigationGroups}"
                      ItemContainerTheme="{StaticResource NavigationGroupTheme}" />
            <MenuItem Header="_Справка">
              <MenuItem Header="О программе" Click="OnAboutClick" />
            </MenuItem>
          </Menu>
        </DockPanel>
      </Border>

      <!-- Группы разделов, разрешённых роли -->
      <Border DockPanel.Dock="Top" Classes="modbar" IsEnabled="{Binding !HasPendingEditTransition}">
        <DockPanel>
          <Button DockPanel.Dock="Left" Classes="mod" Width="32" Padding="0,2,0,0"
                  HorizontalContentAlignment="Center" AutomationProperties.Name="Назад" ToolTip.Tip="Назад" Command="{Binding BackCommand}">
            <Path Data="M13,8 L3,8 M7.5,3.5 L3,8 L7.5,12.5" Width="16" Height="16" />
          </Button>
          <Button DockPanel.Dock="Left" Classes="mod" Classes.current="{Binding IsOnDesktop}" Width="32" Padding="0,2,0,0"
                  HorizontalContentAlignment="Center" AutomationProperties.Name="Рабочий стол" ToolTip.Tip="Рабочий стол"
                  Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Desktop}">
            <Path Data="M2,7.5 L8,2.5 L14,7.5 M4,6.5 L4,13 L7,13 L7,9.5 L9,9.5 L9,13 L12,13 L12,6.5" Width="16" Height="16" />
          </Button>
          <Button DockPanel.Dock="Right" Classes="mod" IsVisible="{Binding CanOpenMap}" Command="{Binding OpenMapCommand}"
                  AutomationProperties.Name="Карта города"
                  ToolTip.Tip="Офлайн-карта города в браузере, на выбранном доме или доме заявки">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="navglyph"><Path Data="M12,22 Q3,14 3,10 A9,9 0 0 1 21,10 Q21,14 12,22 Z M12,13 A3,3 0 1 0 12,7 A3,3 0 1 0 12,13" Stretch="Uniform" /></Border>
              <TextBlock Text="Карта города" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Menu ItemsSource="{Binding NavigationGroups}" Background="Transparent"
                ItemContainerTheme="{StaticResource NavigationGroupTheme}" />
        </DockPanel>
      </Border>

      <!-- Строка состояния -->
      <Border DockPanel.Dock="Bottom" Classes="statusbar">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Margin="24,0,0,0" Text="{Binding WorkDateText}" />
          <TextBlock DockPanel.Dock="Right" Margin="24,0,0,0" Text="{Binding UserLine}" />
          <TextBlock x:Name="ShellVersion" DockPanel.Dock="Right" Margin="24,0,0,0" Text="{Binding ApplicationVersion}" />
          <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>

      <!-- Заголовок экрана: модуль серым и название окна -->
      <Border DockPanel.Dock="Top" Classes="screenhead" IsVisible="{Binding !IsOnDesktop}">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Classes="crumb" Text="{Binding ModuleTitle, StringFormat='{}{0} ›'}" />
          <TextBlock Grid.Column="1" Classes="h1" Margin="8,0,0,0" Text="{Binding WindowTitle}" TextWrapping="Wrap" />
        </Grid>
      </Border>

      <views:EditGuardView DockPanel.Dock="Top" IsVisible="{Binding HasPendingEditTransition}" />
      <Panel IsEnabled="{Binding CanUseWorkspace}">
        <views:DesktopView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Desktop}}" />
        <views:AbonView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Abon}}" />
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Disp}}">
          <views:DispView DataContext="{Binding TicketsScreen}" />
        </Panel>
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Ticket}}">
          <views:TicketView DataContext="{Binding TicketsScreen}" />
        </Panel>
        <views:AntenView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Anten}}" />
        <views:AntenInfoView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.AntenInfo}}" />
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Scheme}}">
          <views:SchemeView DataContext="{Binding SchemeScreen}" />
        </Panel>
        <views:SubscriberView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Subscriber}}" />
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.PrDubl}}">
          <views:PrDublView DataContext="{Binding ReceiptsScreen}" />
        </Panel>
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Contract}}">
          <views:ContractView DataContext="{Binding ContractsScreen}" />
        </Panel>
        <views:PrintView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Print}}" />
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Ppr}}">
          <views:PprView DataContext="{Binding PprScreen}" />
        </Panel>
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Legal}}">
          <views:LegalView DataContext="{Binding LegalScreen}" />
        </Panel>
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Claim}}">
          <views:ClaimView DataContext="{Binding LegalScreen}" />
        </Panel>
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Reports}}">
          <views:ReportsView DataContext="{Binding ReportsScreen}" />
        </Panel>
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Phonebook}}">
          <views:PhonebookView DataContext="{Binding PhonebookScreen}" />
        </Panel>
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Domofo}}">
          <views:DomofoView DataContext="{Binding IntercomScreen}" />
        </Panel>
        <views:ReaderView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Reader}}" />
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Access}}">
          <views:AccessView DataContext="{Binding AccessScreen}" />
        </Panel>
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.ChangeLog}}">
          <views:ChangeLogView DataContext="{Binding ChangeLogScreen}" />
        </Panel>
      </Panel>
    </DockPanel>
    <ProgressBar IsVisible="{Binding IsLoadingSubscriber}" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                 AutomationProperties.Name="Загрузка данных абонента" />
  </Grid>
</Window>
