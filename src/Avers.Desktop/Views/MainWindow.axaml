<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Avers.Desktop.ViewModels"
        xmlns:views="using:Avers.Desktop.Views"
        xmlns:d="using:Avers.Domain"
        x:Class="Avers.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="840" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <!-- Вход: диалог в духе прежних окон Delphi на синем «рабочем столе» -->
    <Grid IsVisible="{Binding ShowLogin}" Background="{StaticResource Desk}">
      <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource Face}" BorderBrush="{StaticResource AccentDark}" BorderThickness="1"
              BoxShadow="0 6 18 0 #55000000">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource CaptionBar}" Padding="10,6">
            <TextBlock Text="Аверс — вход в систему" Foreground="White" FontWeight="Bold" />
          </Border>
          <Border DockPanel.Dock="Bottom" Classes="actionbar">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Classes="primary" Content="Войти" Command="{Binding LoginCommand}" IsDefault="True" MinWidth="80" />
              <Button Content="Отмена" Command="{Binding LogoutCommand}" MinWidth="80" Margin="0" />
            </StackPanel>
          </Border>
          <StackPanel Margin="14,12" Spacing="8">
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Classes="label" Text="Пользователь" />
              <ComboBox Grid.Column="1" Classes="cell" ItemsSource="{Binding Users}" SelectedItem="{Binding LoginUser}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="d:AppUser">
                    <TextBlock Text="{Binding Login}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="1" Classes="label" Text="Пароль" Margin="0,6,8,0" />
              <TextBox Grid.Row="1" Grid.Column="1" Classes="cell" PasswordChar="•" Text="{Binding Password}" Margin="0,6,0,0" />
              <TextBlock Grid.Row="2" Classes="label" Text="Подразделение" Margin="0,6,8,0" />
              <TextBox Grid.Row="2" Grid.Column="1" Classes="cell" IsReadOnly="True"
                       Text="{Binding LoginUser.Department}" Margin="0,6,0,0" />
            </Grid>
            <HeaderedContentControl Classes="group" Header="Назначенная роль" Margin="0">
              <StackPanel>
                <TextBlock FontWeight="Bold" Text="{Binding LoginUser.DisplayName}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding LoginRoleTitle}" />
                <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Права задаются при входе. Редактирование лицевого счёта — отдельное право. Режим администратора не через Alt+Backspace." />
              </StackPanel>
            </HeaderedContentControl>
            <Border Classes="debt" Margin="0" IsVisible="{Binding LoginError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding LoginError}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Рабочее место -->
    <DockPanel IsVisible="{Binding ShowShell}">
      <Menu DockPanel.Dock="Top">
        <MenuItem Header="_Файл">
          <MenuItem Header="Рабочий стол" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Desktop}" />
          <Separator />
          <MenuItem Header="Сменить пользователя" Command="{Binding LogoutCommand}" />
        </MenuItem>
        <MenuItem Header="_Модули" ItemsSource="{Binding Navigation}">
          <MenuItem.Styles>
            <Style Selector="MenuItem" x:DataType="vm:NavItem">
              <Setter Property="Header" Value="{Binding Title}" />
              <Setter Property="Command" Value="{Binding Go}" />
              <Setter Property="CommandParameter" Value="{Binding Module}" />
              <Setter Property="InputGesture" Value="{x:Null}" />
            </Style>
          </MenuItem.Styles>
        </MenuItem>
        <MenuItem Header="_Справка">
          <MenuItem Header="Образцы оформления" Click="OnStyleGuideClick" />
          <MenuItem Header="О программе" Command="{Binding SavedCommand}" />
        </MenuItem>
      </Menu>

      <!-- Панель модулей: только то, что разрешено роли -->
      <Border DockPanel.Dock="Top" Classes="toolbar" Padding="6,3">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Выйти" Command="{Binding LogoutCommand}" Margin="6,0,0,0"
                  VerticalAlignment="Center" ToolTip.Tip="Сменить пользователя" />
          <Button DockPanel.Dock="Left" Classes="nav" Classes.current="{Binding IsOnDesktop}" ToolTip.Tip="Все модули"
                  Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Desktop}" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="navglyph" Background="{StaticResource Desk}"><TextBlock Text="▦" /></Border>
              <TextBlock Text="Рабочий стол" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border DockPanel.Dock="Left" Width="1" Margin="2,3,6,3" Background="{StaticResource Edge}" />
          <ItemsControl ItemsSource="{Binding Navigation}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Button Classes="nav" Classes.current="{Binding IsCurrent}" ToolTip.Tip="{Binding Hint}"
                        Command="{Binding Go}" CommandParameter="{Binding Module}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Border Classes="navglyph"><TextBlock Text="{Binding Glyph}" /></Border>
                    <TextBlock Text="{Binding ShortTitle}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- Заголовок текущего окна, как полоса заголовка формы в прежнем Аверсе -->
      <Border DockPanel.Dock="Top" Background="{StaticResource CaptionBar}" Padding="10,5">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#DDE6F5" FontSize="11"
                     Text="{Binding WorkDateText, StringFormat='Рабочая дата {0}'}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding ModuleTitle}" Foreground="#BFD0EC" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="›" Foreground="#BFD0EC" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsOnDesktop}" />
            <TextBlock Text="{Binding WindowTitle}" Foreground="White" FontWeight="Bold" FontSize="13"
                       VerticalAlignment="Center" IsVisible="{Binding !IsOnDesktop}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Строка состояния -->
      <Border DockPanel.Dock="Bottom" Classes="statusbar">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <Border Classes="statuscell"><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" /></Border>
          <Border Grid.Column="1" Classes="statuscell" MinWidth="120"><TextBlock Text="{Binding ModuleLegacyName}" /></Border>
          <Border Grid.Column="2" Classes="statuscell" MinWidth="200"><TextBlock Text="{Binding UserLine}" /></Border>
          <Border Grid.Column="3" Classes="statuscell" Margin="0"><TextBlock Text="{Binding WorkDateText}" /></Border>
        </Grid>
      </Border>

      <Panel Background="{StaticResource Face}">
        <views:DesktopView IsVisible="{Binding ShowDesktop}" />
        <views:AbonView IsVisible="{Binding ShowAbon}" />
        <views:DispView IsVisible="{Binding ShowDisp}" />
        <views:TicketView IsVisible="{Binding ShowTicket}" />
        <views:AntenView IsVisible="{Binding ShowAnten}" />
        <views:AntenInfoView IsVisible="{Binding ShowAntenInfo}" />
        <views:SchemeView IsVisible="{Binding ShowScheme}" />
        <views:SubscriberView IsVisible="{Binding ShowSubscriber}" />
        <views:PrDublView IsVisible="{Binding ShowPrDubl}" />
        <views:ContractView IsVisible="{Binding ShowContract}" />
        <views:PrintView IsVisible="{Binding ShowPrint}" />
        <views:PprView IsVisible="{Binding ShowPpr}" />
        <views:LegalView IsVisible="{Binding ShowLegal}" />
        <views:ClaimView IsVisible="{Binding ShowClaim}" />
        <views:ReportsView IsVisible="{Binding ShowReports}" />
        <views:PhonebookView IsVisible="{Binding ShowPhonebook}" />
        <views:DomofoView IsVisible="{Binding ShowDomofo}" />
        <views:ReaderView IsVisible="{Binding ShowReader}" />
        <views:AccessView IsVisible="{Binding ShowAccess}" />
      </Panel>
    </DockPanel>
  </Grid>
</Window>
