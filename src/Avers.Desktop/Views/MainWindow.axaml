<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Avers.Desktop.ViewModels"
        xmlns:views="using:Avers.Desktop.Views"
        xmlns:d="using:Avers.Domain"
        xmlns:ctl="using:Avers.Desktop.Controls"
        x:Class="Avers.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/avers.ico"
        Width="1280" Height="840" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <!-- Вход: белая карточка на тёмно-синем фоне -->
    <Panel IsVisible="{Binding ShowLogin}" Background="{StaticResource TopBar}">
      <Border Classes="card" Width="420" Padding="0" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <Border Padding="24,20,24,16" BorderBrush="{StaticResource EdgeLight}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <Image Source="/Assets/logo-avers-servis.png" Height="72" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="АВЕРС" FontSize="22" FontWeight="SemiBold" LetterSpacing="1.3" Foreground="{StaticResource Caption}" />
                <TextBlock Classes="crumb" Margin="0,2,0,0" Text="Антенная служба · вход в систему" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Grid Margin="24,16" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Classes="label" Text="Пользователь" />
            <TextBox Grid.Column="1" Classes="cell" MinHeight="28" Text="{Binding LoginName}" IsVisible="{Binding IsShared}" />
            <ComboBox Grid.Column="1" Classes="cell" MinHeight="28" ItemsSource="{Binding Users}" SelectedItem="{Binding LoginUser}"
                      IsVisible="{Binding !IsShared}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="d:AppUser">
                  <TextBlock Text="{Binding Login}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Classes="label" Text="Пароль" Margin="0,8,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Classes="cell" MinHeight="28" PasswordChar="•" Text="{Binding Password}" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Classes="label" Text="Подразделение" Margin="0,8,8,0" IsVisible="{Binding !IsShared}" />
            <TextBox Grid.Row="2" Grid.Column="1" Classes="cell" MinHeight="28" IsReadOnly="True" IsVisible="{Binding !IsShared}"
                     Text="{Binding LoginUser.Department}" Margin="0,8,0,0" />
          </Grid>
          <Border Classes="inset" Margin="24,0" IsVisible="{Binding !IsShared}">
            <StackPanel>
              <TextBlock TextWrapping="Wrap">
                <Run Text="{Binding LoginUser.DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="·" />
                <Run Text="{Binding LoginRoleTitle, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="Права задаются при входе. Редактирование лицевого счёта — отдельное право. Режим администратора не через Alt+Backspace." />
            </StackPanel>
          </Border>
          <Border Classes="debt" Margin="24,12,24,0" IsVisible="{Binding LoginError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding LoginError}" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16">
            <Button Content="Отмена" Command="{Binding LogoutCommand}" MinHeight="30" Padding="16,4" />
            <Button Classes="primary" Content="Войти" Command="{Binding LoginCommand}" IsDefault="True"
                    MinHeight="30" MinWidth="96" Padding="16,4" Margin="0" HorizontalContentAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,12" FontSize="12"
                 Foreground="{StaticResource TopBarDim}">
        <Run Text="{Binding StoreTitle, StringFormat='Аверс 2026 · {0}', Mode=OneWay}" />
        <Run Text="{Binding WorkDateText, StringFormat='· рабочая дата {0}', Mode=OneWay}" />
      </TextBlock>
    </Panel>

    <!-- Рабочее место -->
    <DockPanel IsVisible="{Binding ShowShell}">
      <!-- Шапка: марка, меню, рабочая дата, пользователь, выход -->
      <Border DockPanel.Dock="Top" Classes="topbar">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" Margin="0,0,14,0">
            <Image Source="/Assets/logo-avers-servis.png" Height="26" VerticalAlignment="Center" />
            <TextBlock Classes="brand" Text="АВЕРС" />
          </StackPanel>
          <Button DockPanel.Dock="Right" Classes="ontop" Content="Выйти" Command="{Binding LogoutCommand}"
                  VerticalAlignment="Center" ToolTip.Tip="Сменить пользователя" />
          <TextBlock DockPanel.Dock="Right" Classes="ontop" Margin="14,0">
            <Run Classes="strong" Text="{Binding User.DisplayName, Mode=OneWay}" />
            <Run Text="·" />
            <Run Text="{Binding UserRoleTitle, Mode=OneWay}" />
          </TextBlock>
          <TextBlock DockPanel.Dock="Right" Classes="ontop">
            <Run Text="Рабочая дата" />
            <Run Classes="strong" Text="{Binding WorkDateText, Mode=OneWay}" />
          </TextBlock>
          <Menu Classes="topmenu" HorizontalAlignment="Left">
            <MenuItem Header="_Файл">
              <MenuItem Header="Рабочий стол" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Desktop}" />
              <Separator />
              <MenuItem Header="Сменить пользователя" Command="{Binding LogoutCommand}" />
            </MenuItem>
            <MenuItem Header="_Модули" ItemsSource="{Binding Navigation}">
              <MenuItem.Styles>
                <Style Selector="MenuItem" x:DataType="vm:NavItem">
                  <Setter Property="Header" Value="{Binding Title}" />
                  <Setter Property="Command" Value="{Binding Go}" />
                  <Setter Property="CommandParameter" Value="{Binding Module}" />
                  <Setter Property="InputGesture" Value="{x:Null}" />
                </Style>
              </MenuItem.Styles>
            </MenuItem>
            <MenuItem Header="_Справка">
              <MenuItem Header="Образцы оформления" Click="OnStyleGuideClick" />
              <MenuItem Header="О программе" Click="OnAboutClick" />
            </MenuItem>
          </Menu>
        </DockPanel>
      </Border>

      <!-- Полоса модулей: рабочий стол и модули, разрешённые роли -->
      <Border DockPanel.Dock="Top" Classes="modbar">
        <DockPanel>
          <Button DockPanel.Dock="Left" Classes="mod" Width="32" Padding="0,2,0,0"
                  HorizontalContentAlignment="Center" ToolTip.Tip="Назад" Command="{Binding BackCommand}">
            <Path Data="M13,8 L3,8 M7.5,3.5 L3,8 L7.5,12.5" Width="16" Height="16" />
          </Button>
          <Button DockPanel.Dock="Left" Classes="mod" Classes.current="{Binding IsOnDesktop}" Width="32" Padding="0,2,0,0"
                  HorizontalContentAlignment="Center" ToolTip.Tip="Рабочий стол"
                  Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Desktop}">
            <Path Data="M2,7.5 L8,2.5 L14,7.5 M4,6.5 L4,13 L7,13 L7,9.5 L9,9.5 L9,13 L12,13 L12,6.5" Width="16" Height="16" />
          </Button>
          <ItemsControl ItemsSource="{Binding Navigation}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Button Classes="mod" Classes.current="{Binding IsCurrent}" ToolTip.Tip="{Binding Hint}"
                        Command="{Binding Go}" CommandParameter="{Binding Module}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="navglyph"><TextBlock Text="{Binding Glyph}" /></Border>
                    <TextBlock Text="{Binding ShortTitle}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- Строка состояния -->
      <Border DockPanel.Dock="Bottom" Classes="statusbar">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Margin="24,0,0,0" Text="{Binding WorkDateText}" />
          <TextBlock DockPanel.Dock="Right" Margin="24,0,0,0" Text="{Binding UserLine}" />
          <TextBlock DockPanel.Dock="Right" Margin="24,0,0,0" Text="{Binding ModuleLegacyName}" />
          <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>

      <!-- Заголовок экрана: модуль серым и название окна -->
      <Border DockPanel.Dock="Top" Classes="screenhead" IsVisible="{Binding !IsOnDesktop}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="crumb" Text="{Binding ModuleTitle, StringFormat='{}{0} ›'}" />
          <TextBlock Classes="h1" Text="{Binding WindowTitle}" />
        </StackPanel>
      </Border>

      <Panel>
        <views:DesktopView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Desktop}}" />
        <views:AbonView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Abon}}" />
        <views:DispView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Disp}}" />
        <views:TicketView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Ticket}}" />
        <views:AntenView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Anten}}" />
        <views:AntenInfoView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.AntenInfo}}" />
        <views:SchemeView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Scheme}}" />
        <views:SubscriberView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Subscriber}}" />
        <views:PrDublView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.PrDubl}}" />
        <views:ContractView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Contract}}" />
        <views:PrintView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Print}}" />
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Ppr}}">
          <views:PprView DataContext="{Binding PprScreen}" />
        </Panel>
        <views:LegalView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Legal}}" />
        <views:ClaimView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Claim}}" />
        <views:ReportsView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Reports}}" />
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Phonebook}}">
          <views:PhonebookView DataContext="{Binding PhonebookScreen}" />
        </Panel>
        <views:DomofoView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Domofo}}" />
        <views:ReaderView IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Reader}}" />
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.Access}}">
          <views:AccessView DataContext="{Binding AccessScreen}" />
        </Panel>
        <Panel IsVisible="{Binding Module, Converter={x:Static ctl:Is.Equal}, ConverterParameter={x:Static d:AppModule.ChangeLog}}">
          <views:ChangeLogView DataContext="{Binding ChangeLogScreen}" />
        </Panel>
      </Panel>
    </DockPanel>
  </Grid>
</Window>
