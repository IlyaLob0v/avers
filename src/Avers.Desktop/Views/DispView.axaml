<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             xmlns:d="using:Avers.Domain"
             xmlns:ctl="using:Avers.Desktop.Controls"
             x:Class="Avers.Desktop.Views.DispView"
             x:DataType="vm:TicketsViewModel">
  <UserControl.Styles>
    <Style Selector="StackPanel.f > TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="WrapPanel > StackPanel.f">
      <Setter Property="Margin" Value="0,0,12,4" />
    </Style>
    <Style Selector="Button.month">
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="2,3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.month.selected">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.month.open TextBlock.counts">
      <Setter Property="Foreground" Value="{StaticResource WarnText}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16,0,16,12">
    <WrapPanel Margin="0,0,0,8">
      <Button Classes="primary" Content="Новая заявка" Command="{Binding ShowNewTicketCommand}" IsVisible="{Binding CanAcceptTickets}" />
      <Button Content="Открыть заявку" Command="{Binding OpenTicketCommand}" />
      <Button Content="Паспорт дома" Command="{Binding OpenTicketHouseCommand}" />
      <Button Content="Печать наряд-заказа" Command="{Binding PrintWorkOrderCommand}" />
    </WrapPanel>

    <Border Grid.Row="1" Classes="card" Margin="0,0,0,8" IsVisible="{Binding IsNewTicketOpen}">
      <ScrollViewer MaxHeight="300">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="Новая заявка" />
          <WrapPanel>
            <Button Classes="primary" Content="Принять заявку" Command="{Binding AcceptTicketCommand}" />
            <Button Content="Проверить открытые заявки" Command="{Binding CheckRepeatCallCommand}" />
            <Button Content="Отмена" Command="{Binding CancelNewTicketCommand}" />
          </WrapPanel>
          <Border Classes="warn" IsVisible="{Binding HasNewTicketHouseFault}"><TextBlock Text="{Binding NewTicketHouseFaultText}" TextWrapping="Wrap" /></Border>
          <Grid ColumnDefinitions="3*,100,128,90,160">
            <StackPanel Classes="f">
              <TextBlock Text="Улица" />
              <ComboBox Classes="cell" HorizontalAlignment="Stretch" ItemsSource="{Binding Shell.Streets}" SelectedItem="{Binding NewTicketStreet}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="d:Street"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Classes="f" Margin="8,0,0,0">
              <TextBlock Text="Дом" />
              <ComboBox Classes="cell" HorizontalAlignment="Stretch" ItemsSource="{Binding NewTicketHouses}" SelectedItem="{Binding NewTicketHouse}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="d:House"><TextBlock Text="{Binding Number}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Classes="f" Margin="8,0,0,0"><TextBlock Text="Подъезд / секция" /><TextBox x:Name="NewTicketSection" Classes="cell" Text="{Binding NewTicketSection}" /></StackPanel>
            <StackPanel Grid.Column="3" Classes="f" Margin="8,0,0,0"><TextBlock Text="Квартира" /><TextBox x:Name="NewTicketApartment" Classes="cell" Text="{Binding NewTicketApartment}" /></StackPanel>
            <StackPanel Grid.Column="4" Classes="f" Margin="8,0,0,0"><TextBlock Text="Вид заявки" /><ComboBox Classes="cell" HorizontalAlignment="Stretch" ItemsSource="{Binding NewTicketKinds}" SelectedItem="{Binding NewTicketKind}" /></StackPanel>
          </Grid>
          <StackPanel Classes="f">
            <TextBlock Text="Описание неисправности — обязательно" />
            <TextBox x:Name="NewTicketFault" Classes="cell" MinHeight="44" MaxHeight="90" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding NewTicketFault}" PlaceholderText="Что случилось, где и при каких условиях — со слов заявителя" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*">
            <StackPanel Classes="f"><TextBlock Text="Телефон заявителя" /><TextBox x:Name="NewTicketPhone" Classes="cell" Text="{Binding NewTicketPhone}" PlaceholderText="Телефон для связи по этой заявке" /></StackPanel>
            <StackPanel Grid.Column="1" Classes="f" Margin="12,0,0,0">
              <TextBlock Text="Ответственный — можно назначить позднее" />
              <AutoCompleteBox x:Name="NewTicketMechanic" Classes="cell" ItemsSource="{Binding MechanicNames}" Text="{Binding NewTicketMechanic}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" PlaceholderText="Не назначен" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="hint" Text="{Binding NewTicketDueText}" TextWrapping="Wrap" />
          <TextBlock Classes="hint" Text="{Binding RepeatCallStatus}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding RepeatCallTickets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="d:WorkTicket">
                <Button HorizontalAlignment="Stretch" Command="{Binding $parent[UserControl].((vm:TicketsViewModel)DataContext).OpenRepeatCallTicketCommand}" CommandParameter="{Binding}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Number, StringFormat='№ {0}'}" Margin="0,0,8,0" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Apartment, StringFormat='Кв. {0}'}" Margin="0,0,8,0" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding StatusDescription}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Fault}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Expander Header="Сведения о выбранном доме" IsVisible="{Binding HasNewTicketHouse}">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding NewTicketHouse.AddressLine}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding NewTicketHouse.Organization.Name}" />
              <TextBlock Text="{Binding NewTicketHouse.Organization.Phones}" />
              <TextBlock Text="{Binding NewTicketHouse.Antennas}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding NewTicketHouse.Amplifiers}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding NewTicketHouse.TechFloorKey}" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,8">
      <Border Classes="card" Padding="10,6">
        <StackPanel>
          <WrapPanel>
            <StackPanel Classes="f"><TextBlock Text="Где искать" /><ComboBox Classes="cell" Width="155" ItemsSource="{Binding TicketScopes}" SelectedItem="{Binding ScopeFilter}" /></StackPanel>
            <StackPanel Classes="f">
              <TextBlock Text="Улица / дом для отбора" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ComboBox Classes="cell" Width="180" ItemsSource="{Binding Shell.Streets}" SelectedItem="{Binding Shell.SelectedStreet}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="d:Street"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Classes="cell" Width="78" ItemsSource="{Binding Shell.HousesOnStreet}" SelectedItem="{Binding Shell.SelectedHouse}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="d:House"><TextBlock Text="{Binding Number}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </StackPanel>
            <StackPanel Classes="f"><TextBlock Text="Вид" /><ComboBox Classes="cell" Width="135" ItemsSource="{Binding TicketKinds}" SelectedItem="{Binding KindFilter}" /></StackPanel>
            <StackPanel Classes="f"><TextBlock Text="Состояние" /><ComboBox Classes="cell" Width="125" ItemsSource="{Binding TicketStatuses}" SelectedItem="{Binding StatusFilter}" /></StackPanel>
            <StackPanel Classes="f"><TextBlock Text="Поиск: №, фамилия, неисправность, механик" /><TextBox Classes="cell" MinWidth="240" Text="{Binding TicketSearch}" /></StackPanel>
          </WrapPanel>
          <WrapPanel VerticalAlignment="Center">
            <StackPanel Classes="f"><TextBlock Text="Период с" /><CalendarDatePicker Width="110" SelectedDate="{Binding TicketFrom}" /></StackPanel>
            <StackPanel Classes="f"><TextBlock Text="по" /><CalendarDatePicker Width="110" SelectedDate="{Binding TicketTo}" /></StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,12,4">
              <Button Content="Сегодня" Command="{Binding PeriodTodayCommand}" />
              <Button Content="Месяц" Command="{Binding PeriodMonthCommand}" />
              <Button Content="Год" Command="{Binding PeriodYearCommand}" />
              <Button Content="Всё время" Command="{Binding PeriodAllCommand}" />
            </StackPanel>
            <CheckBox Margin="0,0,12,0" Content="Только невыполненные" IsChecked="{Binding OnlyOpenTickets}" />
            <CheckBox Content="Только просроченные" IsChecked="{Binding OnlyOverdueTickets}" ToolTip.Tip="Принятые и в работе, у которых прошёл срок: 3 дня от приёма" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Expander Header="Сводка по месяцам и выгрузка для ОЭК">
        <StackPanel Spacing="8">
          <WrapPanel>
            <ComboBox Classes="cell" Width="84" ItemsSource="{Binding TicketYears}" SelectedItem="{Binding TicketYear}" Margin="0,0,12,0" />
            <TextBlock Text="{Binding TicketMonthsCaption}" VerticalAlignment="Center" />
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding TicketMonths}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TicketMonthRow">
                <Button Classes="month" Classes.selected="{Binding IsSelected}" Classes.open="{Binding HasOpen}" Command="{Binding Select}" CommandParameter="{Binding Month}" ToolTip.Tip="{Binding Tip}">
                  <StackPanel><TextBlock Text="{Binding Name}" FontSize="12" /><TextBlock Classes="counts" Text="{Binding Counts}" FontWeight="SemiBold" /></StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="hint" Text="Принято / выполнено. Нажмите месяц, чтобы отобрать его заявки." />
          <WrapPanel>
            <CalendarDatePicker Width="110" SelectedDate="{Binding OekDate}" Margin="0,0,8,0" />
            <Button Content="Выгрузить в Excel для ОЭК" Command="{Binding ExportOekCommand}" />
          </WrapPanel>
          <TextBlock Classes="hint" Text="{Binding OekWarning}" TextWrapping="Wrap" />
        </StackPanel>
      </Expander>
    </StackPanel>

    <Grid Grid.Row="3" RowDefinitions="Auto,*">
      <StackPanel Margin="0,0,0,6">
        <TextBlock Text="Журнал заявок" FontWeight="SemiBold" />
        <TextBlock Classes="hint" Text="{Binding TicketCountText}" />
        <TextBlock Classes="hint" Text="{Binding TicketPeriodText}" />
      </StackPanel>
      <DataGrid x:Name="TicketJournal" Grid.Row="1" MinHeight="100" ctl:GridTone.Enabled="True" ctl:GridTone.Selector="{Binding TicketTone}"
                ItemsSource="{Binding Tickets}" SelectedItem="{Binding JournalSelectedTicket}" AutoGenerateColumns="False" IsReadOnly="True"
                DoubleTapped="OnTicketDoubleTapped" AutomationProperties.Name="Журнал заявок">
        <DataGrid.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding OpenTicketCommand}" /></DataGrid.KeyBindings>
        <DataGrid.Columns>
          <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="65" />
          <DataGridTextColumn Header="Дата" Binding="{Binding Date, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}" Width="95" />
          <DataGridTextColumn Header="Время" Binding="{Binding Time, Mode=OneWay}" Width="60" />
          <DataGridTextColumn Header="Улица" Binding="{Binding House.Street.Name}" Width="110" />
          <DataGridTextColumn Header="Дом" Binding="{Binding House.Number}" Width="58" />
          <DataGridTextColumn Header="Под." Binding="{Binding Section}" Width="50" />
          <DataGridTextColumn Header="Кв." Binding="{Binding Apartment}" Width="50" />
          <DataGridTextColumn Header="ФИО" Binding="{Binding Subscriber.ShortName}" Width="120" />
          <DataGridTextColumn Header="Неисправность" Binding="{Binding Fault}" Width="*" MinWidth="160" />
          <DataGridTextColumn Header="Ответственный" Binding="{Binding Mechanic}" Width="140" />
          <DataGridTextColumn Header="Состояние" Binding="{Binding StatusDescription}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Grid>
</UserControl>
