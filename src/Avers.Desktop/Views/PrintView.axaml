<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             x:Class="Avers.Desktop.Views.PrintView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.form > TextBlock">
      <Setter Property="Margin" Value="0,2,8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <HeaderedContentControl Classes="group" Header="Квитанция на оплату ТО СКПТ" Width="420"
                          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,0,16,12" Padding="16,12">
    <StackPanel Spacing="6">
      <TextBlock HorizontalAlignment="Center" Classes="hint" Text="{Binding HouseCaption}" />
      <Grid Classes="form" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Classes="label" Text="Плательщик" /><TextBlock Grid.Column="1" Text="{Binding SelectedSubscriber.FullName}" />
        <TextBlock Grid.Row="1" Classes="label" Text="Лиц. счёт" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSubscriber.Account}" />
        <TextBlock Grid.Row="2" Classes="label" Text="Индекс" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSubscriber.PzhreuIndex}" />
        <TextBlock Grid.Row="3" Classes="label" Text="Договор" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ContractDateText}" />
        <TextBlock Grid.Row="4" Classes="label" Text="Период" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ReceiptMonthsText}" />
        <TextBlock Grid.Row="5" Classes="label" Text="К оплате" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ReceiptSumText}" />
        <TextBlock Grid.Row="6" Classes="label" Text="Дата оплаты" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastPayCell}" />
      </Grid>
      <CheckBox Content="Лицевой счёт с датой оплаты" IsChecked="{Binding PrintWithPayDate}" />
      <TextBlock Classes="hint" TextWrapping="Wrap" Text="Документ откроется в PDF, печать — из программы просмотра." />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Лицевой счёт" Command="{Binding PrintAccountCommand}" />
        <Button Classes="primary" Margin="0" Content="Квитанция" Command="{Binding PrintReceiptCommand}" />
      </StackPanel>
    </StackPanel>
  </HeaderedContentControl>
</UserControl>
