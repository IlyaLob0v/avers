<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             xmlns:ctl="using:Avers.Desktop.Controls"
             xmlns:d="using:Avers.Domain"
             x:Class="Avers.Desktop.Views.ContractView"
             x:DataType="vm:MainViewModel">
  <DockPanel Margin="16,0,16,12">
    <Border DockPanel.Dock="Top" Classes="card" Padding="12,6">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Classes="label" Text="Улица" />
          <ComboBox Classes="cell" Width="190" Margin="0,0,12,0" ItemsSource="{Binding Streets}" SelectedItem="{Binding SelectedStreet}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="d:Street">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="label" Text="Дом" />
          <ComboBox Classes="cell" Width="90" Margin="0,0,12,0" ItemsSource="{Binding HousesOnStreet}" SelectedItem="{Binding SelectedHouse}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="d:House">
                <TextBlock Text="{Binding Number}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="label" Text="Организация" />
          <TextBox Width="240" Margin="0,0,16,0" Text="{Binding SelectedHouse.Organization.Name, Mode=OneWay}" IsReadOnly="True" />
          <CheckBox Margin="0,0,16,0" Content="Только действующие" IsChecked="{Binding OnlyActiveContracts}" />
          <TextBlock Classes="label" Text="Дата" />
          <TextBox Width="100" Text="{Binding WorkDateText, Mode=OneWay}" IsReadOnly="True" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Classes="label" Text="Поиск" />
          <TextBox Classes="cell" Width="260" PlaceholderText="№ договора или фамилия" Text="{Binding ContractQuery}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding FindContractCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Classes="primary" Margin="8,0,16,0" Content="Найти" Command="{Binding FindContractCommand}" />
          <Button Content="Реестр в Excel" Command="{Binding ExportContractsCommand}" />
          <Button Margin="8,0,0,0" Content="Новая квартира" IsVisible="{Binding CanEditCard}" Command="{Binding StartNewApartmentCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="6" IsVisible="{Binding IsNewApartmentOpen}">
          <TextBox Classes="cell" Width="56" PlaceholderText="Секц" Text="{Binding NewSection}" />
          <TextBox Classes="cell" Width="56" PlaceholderText="Кв" Text="{Binding NewApartment}" />
          <TextBox Classes="cell" Width="96" PlaceholderText="Лиц. счёт" Text="{Binding NewAccount}" />
          <TextBox Classes="cell" Width="130" PlaceholderText="Фамилия" Text="{Binding NewLastName}" />
          <TextBox Classes="cell" Width="110" PlaceholderText="Имя" Text="{Binding NewFirstName}" />
          <TextBox Classes="cell" Width="120" PlaceholderText="Отчество" Text="{Binding NewPatronymic}" />
          <TextBox Classes="cell" Width="120" PlaceholderText="Телефон" Text="{Binding NewPhone}" />
          <TextBox Classes="cell" Width="120" PlaceholderText="№ договора" Text="{Binding NewContractNumber}" />
          <TextBox Classes="cell" Width="96" PlaceholderText="дд.мм.гггг" Text="{Binding NewContractDate}" />
          <TextBox Classes="cell" Width="80" PlaceholderText="₽ в мес." Text="{Binding NewTariff}" />
          <Button Classes="primary" Content="Добавить" Command="{Binding AddApartmentCommand}" />
          <Button Content="Отмена" Command="{Binding CancelNewApartmentCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Выбранный договор: всё, что нужно, чтобы «провалиться» в него -->
    <Border DockPanel.Dock="Bottom" Margin="0" Classes.card="{Binding !IsPaymentLate}" Classes.warn="{Binding IsPaymentLate}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding CardContractLine}" TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0" Text="{Binding CardAddress}" />
          <TextBlock Text="{Binding CardAccount, StringFormat='Лицевой счёт {0}'}" />
          <TextBlock Text="{Binding CardOrganization, StringFormat='Обслуживающая организация: {0}'}" />
          <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding LastPaymentLine}" TextWrapping="Wrap" />
          <TextBlock Classes="hint" Text="{Binding LastPaymentAgo}" />
          <TextBlock Classes="hint" Text="{Binding SelectedSubscriber.Notes, StringFormat='Примечание: {0}'}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Width="640">
          <Grid ColumnDefinitions="Auto,*,Auto,96,Auto,96" RowDefinitions="Auto,Auto,Auto" IsVisible="{Binding CanEditCard}">
            <TextBlock Classes="label" Text="№ договора" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Classes="cell" Text="{Binding EditContractNumber}" />
            <TextBlock Grid.Column="2" Classes="label" Margin="8,0,4,0" Text="Заключён" VerticalAlignment="Center" />
            <TextBox Grid.Column="3" Classes="cell" PlaceholderText="дд.мм.гггг" Text="{Binding EditContractDate}" />
            <TextBlock Grid.Column="4" Classes="label" Margin="8,0,4,0" Text="Расторгнут" VerticalAlignment="Center" />
            <TextBox Grid.Column="5" Classes="cell" PlaceholderText="дд.мм.гггг" Text="{Binding EditContractTerminated}" />
            <TextBlock Grid.Row="1" Classes="label" Text="С кем заключён" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Classes="cell" PlaceholderText="пусто — с самим абонентом" Text="{Binding EditContractHolder}" />
            <TextBlock Grid.Row="2" Classes="label" Text="Примечание" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Classes="cell" Text="{Binding EditNotes}" />
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Новый договор" IsVisible="{Binding CanEditCard}" Command="{Binding NewContractCommand}" />
            <Button Content="Расторгнуть" IsVisible="{Binding CanEditCard}" Command="{Binding TerminateContractCommand}" />
            <Button Classes="primary" Content="Сохранить" IsVisible="{Binding CanEditCard}" Command="{Binding SaveCardCommand}" />
            <Button Classes="link" Margin="0" Content="Карточка квартиры" Command="{Binding OpenCardCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="0,6,0,8"
               Text="Двойной щелчок по строке — карточка квартиры. Жёлтым — давно не было оплаты." />

    <DataGrid x:Name="Registry" ctl:GridTone.Enabled="True" MinHeight="200" ItemsSource="{Binding ContractRows}" SelectedItem="{Binding SelectedContractRow}"
              AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Секц" Binding="{Binding Section}" Width="66" />
        <DataGridTextColumn Header="Кв" Binding="{Binding Apartment}" Width="55" />
        <DataGridTextColumn Header="Лиц. счёт" Binding="{Binding Account}" Width="100" />
        <DataGridTextColumn Header="Фамилия И.О. полностью" Binding="{Binding FullName}" Width="230" />
        <DataGridTextColumn Header="№ договора" Binding="{Binding Number}" Width="150" />
        <DataGridTextColumn Header="С кем заключён" Binding="{Binding Party}" Width="230" />
        <DataGridTextColumn Header="Заключён" Binding="{Binding Signed}" Width="110" />
        <DataGridTextColumn Header="Расторгнут" Binding="{Binding Terminated}" Width="110" />
        <DataGridTextColumn Header="Посл. оплата" Binding="{Binding LastPay}" Width="120" />
        <DataGridTextColumn Header="Мес. без опл." Binding="{Binding MonthsWithoutPay}" Width="110" />
        <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
