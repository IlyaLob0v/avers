<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             xmlns:d="using:Avers.Domain"
             xmlns:ctl="using:Avers.Desktop.Controls"
             x:Class="Avers.Desktop.Views.LegalView"
             x:DataType="vm:MainViewModel">
  <DockPanel Margin="16,0,16,12">
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="legend" Margin="0,0,8,0" Text="Калькулятор обратного отсчёта" VerticalAlignment="Center" />
        <ComboBox Classes="cell" Width="250" ItemsSource="{Binding LegalStages}" SelectedItem="{Binding LegalStage}" DisplayMemberBinding="{Binding Title, x:DataType=d:LegalStage}" />
        <TextBlock Classes="label" Margin="8,0,0,0" VerticalAlignment="Center" Text="Дата события" />
        <CalendarDatePicker Width="110" SelectedDate="{Binding LegalStart}" />
        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Text="{Binding LegalRemaining}" />
      </StackPanel>
    </Border>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,0,0,10">
      <Button Classes="primary" Content="Сформировать претензии (долг ≥ 3 мес.)" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Claim}" />
      <Button Content="Отчёт по должникам" Command="{Binding NotReadyCommand}" CommandParameter="Отчёт по должникам" />
      <Button Content="Пакет документов для суда" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Claim}" />
    </StackPanel>
    <HeaderedContentControl Classes="group" Padding="0">
      <HeaderedContentControl.Header>
        <DockPanel>
          <!-- Легенда цветов строк -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="16">
            <StackPanel Orientation="Horizontal">
              <Border Classes="swatch debt" />
              <TextBlock Classes="hint" VerticalAlignment="Center" Text="задолженность 450 ₽ и более" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Classes="swatch warn" />
              <TextBlock Classes="hint" VerticalAlignment="Center" Text="последняя оплата 3 года и более назад" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="Должники" VerticalAlignment="Center" />
        </DockPanel>
      </HeaderedContentControl.Header>
      <DataGrid ctl:GridTone.Enabled="True" BorderThickness="0" ItemsSource="{Binding Debtors}" SelectedItem="{Binding SelectedDebtor}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ФИО полностью" Binding="{Binding FullName}" Width="260" />
          <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="280" />
          <DataGridTextColumn Header="Долг" Binding="{Binding DebtText}" Width="100" />
          <DataGridTextColumn Header="Неоплачено мес." Binding="{Binding Unpaid}" Width="140" />
          <DataGridTextColumn Header="Последняя оплата" Binding="{Binding LastPay}" Width="200" />
          <DataGridTextColumn Header="Дело-Аверс" Binding="{Binding Case}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </HeaderedContentControl>
  </DockPanel>
</UserControl>
