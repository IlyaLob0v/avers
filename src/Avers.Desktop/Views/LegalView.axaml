<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             xmlns:d="using:Avers.Domain"
             xmlns:ctl="using:Avers.Desktop.Controls"
             x:Class="Avers.Desktop.Views.LegalView"
             x:DataType="vm:LegalViewModel">
  <DockPanel Margin="16,0,16,12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8">
      <Button Content="Назад" Command="{Binding PreviousPageCommand}" ToolTip.Tip="Предыдущие 100 должников" />
      <Button Content="Далее" Command="{Binding NextPageCommand}" ToolTip.Tip="Следующие 100 должников" />
      <Button Content="Обновить" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoadingDebtors}" />
      <TextBlock Classes="hint" Text="Выгрузка и претензии включают весь выбранный отбор" VerticalAlignment="Center" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0">
      <StackPanel>
      <WrapPanel Orientation="Horizontal">
        <TextBlock Classes="legend" Margin="0,0,8,0" Text="Калькулятор обратного отсчёта" VerticalAlignment="Center" />
        <ComboBox Classes="cell" Width="250" ItemsSource="{Binding LegalStages}" SelectedItem="{Binding LegalStage}" DisplayMemberBinding="{Binding Title, x:DataType=d:LegalStage}" />
        <TextBlock Classes="label" Margin="8,0,0,0" VerticalAlignment="Center" Text="Дата исходного события" />
        <CalendarDatePicker Width="110" SelectedDate="{Binding LegalStart}" />
        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Text="{Binding LegalRemaining}" />
      </WrapPanel>
      <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding LegalStageSummary}" />
      </StackPanel>
    </Border>
    <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,0,0,10">
      <Button Classes="primary" Content="Претензии физлицам (долг ≥ 3 мес.)" Command="{Binding PrintAllClaimsCommand}"
              ToolTip.Tip="Уведомления всем должникам без судебного приказа одним файлом Word, каждое с новой страницы" />
      <Button Content="Уведомление выбранному" Command="{Binding Shell.GoCommand}" CommandParameter="{x:Static d:AppModule.Claim}"
              ToolTip.Tip="Уведомление должнику, выбранному в списке: вариант текста, правка и печать через Word" />
      <Button Content="Отчёт по должникам" Command="{Binding ExportDebtorsCommand}" />
      <Button Content="Пакет документов для суда" Command="{Binding Shell.GoCommand}" CommandParameter="{x:Static d:AppModule.Claim}" />
    </WrapPanel>
    <Border DockPanel.Dock="Top" Classes="card" Padding="10,4,10,6">
      <WrapPanel>
        <StackPanel Margin="0,0,10,0">
          <TextBlock Classes="hint" Text="Долг от, ₽" />
          <TextBox Classes="cell" Width="90" Text="{Binding DebtFrom}" />
        </StackPanel>
        <StackPanel Margin="0,0,10,0">
          <TextBlock Classes="hint" Text="Неоплачено от, мес." />
          <TextBox Classes="cell" Width="90" Text="{Binding UnpaidFrom}" />
        </StackPanel>
        <StackPanel Margin="0,0,10,0">
          <TextBlock Classes="hint" Text="Адрес: улица, дом" />
          <TextBox Classes="cell" Width="220" MaxLength="200" Text="{Binding AddressFilter}" PlaceholderText="например, Ленина 12" />
        </StackPanel>
        <StackPanel Margin="0,0,10,0">
          <TextBlock Classes="hint" Text="Судебный приказ" />
          <ComboBox Classes="cell" Width="130" ItemsSource="{Binding CaseFilters}" SelectedItem="{Binding CaseFilter}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="hint" Text="Клиенты" />
          <ComboBox Classes="cell" Width="110" ItemsSource="{Binding ClientFilters}" SelectedItem="{Binding ClientFilter}" />
        </StackPanel>
      </WrapPanel>
    </Border>
    <HeaderedContentControl Classes="group" Padding="0">
      <HeaderedContentControl.Header>
        <DockPanel>
          <!-- Легенда цветов строк -->
          <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <WrapPanel Orientation="Horizontal">
              <Border Classes="swatch debt" />
              <TextBlock Classes="hint" VerticalAlignment="Center" Text="задолженность 450 ₽ и более" />
            </WrapPanel>
            <WrapPanel Orientation="Horizontal">
              <Border Classes="swatch warn" />
              <TextBlock Classes="hint" VerticalAlignment="Center" Text="последняя оплата 3 года и более назад" />
            </WrapPanel>
          </WrapPanel>
          <WrapPanel Orientation="Horizontal">
            <TextBlock Text="Должники" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding DebtorsCountText}" />
          </WrapPanel>
        </DockPanel>
      </HeaderedContentControl.Header>
      <DataGrid ctl:GridTone.Enabled="True" BorderThickness="0" ItemsSource="{Binding Debtors}" SelectedItem="{Binding SelectedDebtor}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ФИО или организация" Binding="{Binding FullName}" Width="260" />
          <DataGridTextColumn Header="Клиент" Binding="{Binding ClientKind}" Width="90" />
          <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="280" />
          <DataGridTextColumn Header="Долг" Binding="{Binding DebtText}" Width="100" />
          <DataGridTextColumn Header="Неоплачено мес." Binding="{Binding Unpaid}" Width="140" />
          <DataGridTemplateColumn Header="Последняя оплата" Width="200">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:DebtorRow">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                  <TextBlock Text="{Binding LastPay}" VerticalAlignment="Center" />
                  <Border Classes="badge warn" IsVisible="{Binding OldPayer}">
                    <TextBlock Text="≥ 3 лет" />
                  </Border>
                </WrapPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Давность старшего долга" Binding="{Binding Limitation}" Width="210" />
          <DataGridTextColumn Header="Судебный приказ" Binding="{Binding Case}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </HeaderedContentControl>
  </DockPanel>
</UserControl>
