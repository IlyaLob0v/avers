<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             xmlns:d="using:Avers.Domain"
             x:Class="Avers.Desktop.Views.LegalView"
             x:DataType="vm:MainViewModel">
  <StackPanel Margin="12">
    <TextBlock Classes="hint" Text="Красная строка — задолженность 450 ₽ и более. Жёлтая — последняя оплата 3 года и более назад." />
    <DataGrid Margin="0,8,0,0" Height="240" ItemsSource="{Binding Debtors}" SelectedItem="{Binding SelectedDebtor}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="ФИО полностью" Binding="{Binding FullName}" Width="240" />
        <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="240" />
        <DataGridTextColumn Header="Долг" Binding="{Binding DebtText}" Width="90" />
        <DataGridTextColumn Header="Мес. без оплаты" Binding="{Binding Unpaid}" Width="120" />
        <DataGridTextColumn Header="Последняя оплата" Binding="{Binding LastPay}" Width="160" />
        <DataGridTextColumn Header="Дело-Аверс" Binding="{Binding Case}" Width="180" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
      <Button Classes="primary" Content="Сформировать претензии (долг ≥ 3 мес.)" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Claim}" />
      <Button Content="Отчёт по должникам" Command="{Binding SavedCommand}" />
      <Button Content="Пакет документов для суда" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Claim}" />
    </StackPanel>
    <Border Classes="card">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="legend" Text="Калькулятор обратного отсчёта" VerticalAlignment="Center" />
        <TextBlock Text="Дата претензии" VerticalAlignment="Center" />
        <TextBox Width="100" Classes="cell" Text="01.08.2026" />
        <TextBlock Text="Срок исполнения" VerticalAlignment="Center" />
        <TextBox Width="100" Classes="cell" Text="31.08.2026" />
        <TextBlock Text="Осталось" VerticalAlignment="Center" />
        <TextBox Width="180" Classes="cell" Text="0 дней (на 31.08.2026)" IsReadOnly="True" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
