<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             x:Class="Avers.Desktop.Views.ClaimView"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="*,*" Margin="16,0,16,12" VerticalAlignment="Top">
    <HeaderedContentControl Classes="group" Margin="0,0,5,0" Header="Досудебное уведомление">
      <StackPanel>
        <TextBox Height="220" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding ClaimText}" />
        <Button Classes="primary" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Печать" Command="{Binding PrintClaimCommand}" />
        <TextBlock Classes="hint" Margin="0,6,0,0" Text="Система отбирает абонентов с долгом более 3 месяцев и готовит текст." />
      </StackPanel>
    </HeaderedContentControl>
    <HeaderedContentControl Grid.Column="1" Classes="group" Margin="5,0,0,0" Header="Пакет документов для суда">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedDebtor.FullName}" />
        <TextBlock Classes="hint" Text="{Binding SelectedDebtor.Case}" />
        <CheckBox Margin="0,6,0,0" IsChecked="{Binding PackageDebtNote}" Content="Справка о задолженности" />
        <CheckBox IsChecked="{Binding PackageHistory}" Content="История платежей (лицевой счёт за каждый год)" />
        <Button Classes="primary" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Выгрузить пакет в PDF" Command="{Binding ExportCourtPackageCommand}" />
        <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap" Text="Копию договора приложите из бумажного архива." />
      </StackPanel>
    </HeaderedContentControl>
  </Grid>
</UserControl>
