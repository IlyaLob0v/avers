<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             xmlns:data="using:Avers.Data"
             xmlns:pr="using:Avers.Desktop.Printing"
             x:Class="Avers.Desktop.Views.ClaimView"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="16,0,16,12" VerticalAlignment="Top">
    <HeaderedContentControl Classes="group" Margin="0,0,5,0" Header="Досудебное уведомление">
      <StackPanel>
        <ComboBox Classes="cell" Width="300" Margin="0,0,0,8" ItemsSource="{Binding ClaimVariants}" SelectedItem="{Binding ClaimVariant}" DisplayMemberBinding="{Binding Title, x:DataType=pr:ClaimVariant}" />
        <TextBox Height="220" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding ClaimText}" />
        <Button Classes="primary" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Открыть в Word" Command="{Binding PrintClaimCommand}" />
        <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap" Text="Текст по образцу юристов; адрес, сумму и дату отключения Аверс подставляет сам. Окончательно правится в Word." />
      </StackPanel>
    </HeaderedContentControl>
    <HeaderedContentControl Grid.Column="1" Classes="group" Margin="5,0,0,0" Header="Пакет документов для суда">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedDebtor.FullName}" />
        <TextBlock Classes="hint" Text="{Binding SelectedDebtor.Case}" />
        <CheckBox Margin="0,6,0,0" IsChecked="{Binding PackageDebtNote}" Content="Справка о задолженности" />
        <CheckBox IsChecked="{Binding PackageHistory}" Content="История платежей (лицевой счёт за каждый год)" />
        <Button Classes="primary" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Выгрузить пакет в PDF" Command="{Binding ExportCourtPackageCommand}" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="8">
          <TextBlock Classes="label" VerticalAlignment="Center" Text="Неустойка на" />
          <CalendarDatePicker Width="110" PlaceholderText="сегодня" SelectedDate="{Binding PenaltyDate}" />
          <Button Content="Расчёт неустойки" Command="{Binding PrintPenaltyCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="8">
          <Button Content="Заявление на судебный приказ (Word)" Command="{Binding PrintCourtOrderCommand}" />
          <Button Content="Заявление в ОСП (Word)" Command="{Binding PrintEnforcementCommand}" />
        </StackPanel>
        <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap" Text="Копию договора приложите из бумажного архива." />
      </StackPanel>
    </HeaderedContentControl>
    <HeaderedContentControl Grid.Row="1" Grid.ColumnSpan="2" Classes="group" Margin="0,10,0,0" Header="Судебное дело (последнее)">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,140,Auto,140,Auto,110,Auto,110" RowDefinitions="Auto,Auto,Auto,Auto,Auto" IsEnabled="{Binding CanEditCourtCases}">
          <TextBlock Classes="label" VerticalAlignment="Center" Text="Дело-Аверс №" />
          <TextBox Grid.Column="1" Classes="cell" Text="{Binding CaseNumber}" />
          <TextBlock Grid.Column="2" Classes="label" Margin="8,0,4,0" VerticalAlignment="Center" Text="Приказ №" />
          <TextBox Grid.Column="3" Classes="cell" Text="{Binding CaseOrder}" />
          <TextBlock Grid.Column="4" Classes="label" Margin="8,0,4,0" VerticalAlignment="Center" Text="от" />
          <TextBox Grid.Column="5" Classes="cell" PlaceholderText="дд.мм.гггг" Text="{Binding CaseDate}" />
          <TextBlock Grid.Column="6" Classes="label" Margin="8,0,4,0" VerticalAlignment="Center" Text="Сумма" />
          <TextBox Grid.Column="7" Classes="cell" Text="{Binding CaseAmount}" />
          <TextBlock Grid.Row="1" Classes="label" VerticalAlignment="Center" Text="Суд" />
          <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Classes="cell" Text="{Binding CaseCourt}" />
          <TextBlock Grid.Row="1" Grid.Column="4" Classes="label" Margin="8,0,4,0" VerticalAlignment="Center" Text="Состояние" />
          <TextBox Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="3" Classes="cell" Text="{Binding CaseStatus}" />
          <TextBlock Grid.Row="2" Classes="label" VerticalAlignment="Center" Text="Госпошлина" />
          <TextBox Grid.Row="2" Grid.Column="1" Classes="cell" Text="{Binding CaseDuty}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Classes="label" Margin="8,0,4,0" VerticalAlignment="Center" Text="Лист направлен" />
          <TextBox Grid.Row="2" Grid.Column="3" Classes="cell" PlaceholderText="ОСП или ОСФР" Text="{Binding CaseWritTo}" />
          <TextBlock Grid.Row="2" Grid.Column="4" Classes="label" Margin="8,0,4,0" VerticalAlignment="Center" Text="дата" />
          <TextBox Grid.Row="2" Grid.Column="5" Classes="cell" PlaceholderText="дд.мм.гггг" Text="{Binding CaseWritDate}" />
          <TextBlock Grid.Row="3" Classes="label" VerticalAlignment="Center" Text="Поступления" />
          <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="7" Classes="cell" PlaceholderText="901,58-28.11.24 + 214,93-24.12.24" Text="{Binding CaseReceipts}" />
          <TextBlock Grid.Row="4" Classes="label" VerticalAlignment="Center" Text="Примечание" />
          <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="7" Classes="cell" Text="{Binding CaseNotes}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="8" IsVisible="{Binding CanEditCourtCases}">
          <Button Content="Новое дело" Command="{Binding NewCourtCaseCommand}" />
          <Button Classes="primary" Content="Сохранить дело" Command="{Binding SaveCourtCaseCommand}" />
        </StackPanel>
      </StackPanel>
    </HeaderedContentControl>
    <HeaderedContentControl Grid.Row="2" Grid.ColumnSpan="2" Classes="group" Margin="0,10,0,0" Header="Сканы документов">
      <StackPanel>
        <ListBox Height="110" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="data:DocumentInfo">
              <TextBlock>
                <Run FontWeight="SemiBold" Text="{Binding Kind, Mode=OneWay}" />
                <Run Text="{Binding Name, StringFormat='· {0}', Mode=OneWay}" />
                <Run Classes="hint" Text="{Binding AddedBy, StringFormat='· {0}', Mode=OneWay}" />
              </TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="8">
          <Button Content="Открыть" Command="{Binding OpenDocumentCommand}" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanEditCourtCases}">
            <ComboBox Classes="cell" Width="180" ItemsSource="{Binding DocumentKinds}" SelectedItem="{Binding DocumentKind}" />
            <Button Classes="primary" Content="Добавить скан" Command="{Binding AddDocumentCommand}" />
            <Button Content="Удалить скан" Command="{Binding DeleteDocumentCommand}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Classes="hint" Margin="0,6,0,0" Text="PDF, JPG или PNG до 20 МБ." />
      </StackPanel>
    </HeaderedContentControl>
  </Grid>
</UserControl>
