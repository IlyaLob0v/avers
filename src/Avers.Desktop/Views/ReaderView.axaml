<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             xmlns:d="using:Avers.Domain"
             x:Class="Avers.Desktop.Views.ReaderView"
             x:DataType="vm:MainViewModel">
  <StackPanel Margin="16,0,16,12">
    <TextBlock Classes="hint" TextWrapping="Wrap" Text="Радиомеханик входит с правом читателя. Улица и номер дома. Схема на экране, выгрузка файла недоступна." />
    <Border Classes="card" Margin="0,8,0,10" Padding="12,6">
      <StackPanel Orientation="Horizontal">
        <TextBlock Classes="label" Text="Улица" />
        <ComboBox Width="200" Margin="0,0,16,0" ItemsSource="{Binding Streets}" SelectedItem="{Binding SelectedStreet}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="d:Street">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="label" Text="Дом" />
        <ComboBox Width="90" ItemsSource="{Binding HousesOnStreet}" SelectedItem="{Binding SelectedHouse}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="d:House">
              <TextBlock Text="{Binding Number}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Border>
    <Grid ColumnDefinitions="*,*">
      <HeaderedContentControl Classes="group" Margin="0,0,5,10" Header="Организация">
        <StackPanel>
          <TextBlock Text="{Binding SelectedHouse.Organization.Name}" />
          <TextBlock Text="{Binding SelectedHouse.Organization.Branch}" />
          <TextBlock Text="{Binding SelectedHouse.Organization.Address}" />
          <TextBlock Text="{Binding SelectedHouse.Organization.Phones}" />
          <TextBlock Text="{Binding SelectedHouse.Organization.HeadName}" />
        </StackPanel>
      </HeaderedContentControl>
      <HeaderedContentControl Grid.Column="1" Classes="group" Margin="5,0,0,10" Header="Техника">
        <StackPanel>
          <TextBlock TextWrapping="Wrap" Text="{Binding SelectedHouse.Antennas}" />
          <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding SelectedHouse.AerialCables}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding SelectedHouse.Amplifiers}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding SelectedHouse.PowerSupplies}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding SelectedHouse.TechFloorKey}" />
        </StackPanel>
      </HeaderedContentControl>
    </Grid>
    <Button HorizontalAlignment="Left" Content="Схема СКПТ (без выгрузки)" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Scheme}" />
  </StackPanel>
</UserControl>
