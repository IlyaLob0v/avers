<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             xmlns:d="using:Avers.Domain"
             x:Class="Avers.Desktop.Views.SchemeView"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="*,280" Margin="12">
    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="legend" Text="Схема стояков · JPEG / PNG / SVG / XLSX" />
        <Border Background="#F4F9FD" Height="280" BorderBrush="#9EC0DE" BorderThickness="1">
          <Canvas>
            <TextBlock Canvas.Left="12" Canvas.Top="10" Text="{Binding HouseCaption}" Foreground="#0B5CAB" />
            <Ellipse Canvas.Left="170" Canvas.Top="36" Width="12" Height="12" Fill="#0078D4" />
            <TextBlock Canvas.Left="188" Canvas.Top="34" Text="Антенна" Foreground="#0078D4" FontSize="11" />
            <Rectangle Canvas.Left="40" Canvas.Top="70" Width="70" Height="22" Fill="White" Stroke="#0B5CAB" />
            <Rectangle Canvas.Left="120" Canvas.Top="70" Width="70" Height="22" Fill="White" Stroke="#0B5CAB" />
            <Rectangle Canvas.Left="200" Canvas.Top="70" Width="70" Height="22" Fill="White" Stroke="#0B5CAB" />
            <Rectangle Canvas.Left="280" Canvas.Top="70" Width="70" Height="22" Fill="White" Stroke="#0B5CAB" />
            <Rectangle Canvas.Left="50" Canvas.Top="230" Width="50" Height="14" Fill="#0B5CAB" />
            <Rectangle Canvas.Left="130" Canvas.Top="230" Width="50" Height="14" Fill="#0B5CAB" />
            <Rectangle Canvas.Left="210" Canvas.Top="230" Width="50" Height="14" Fill="#0B5CAB" />
            <Rectangle Canvas.Left="290" Canvas.Top="230" Width="50" Height="14" Fill="#0B5CAB" />
            <TextBlock Canvas.Left="54" Canvas.Top="250" FontSize="11" Text="под. 1" />
            <TextBlock Canvas.Left="134" Canvas.Top="250" FontSize="11" Text="под. 2" />
            <TextBlock Canvas.Left="214" Canvas.Top="250" FontSize="11" Text="под. 3" />
            <TextBlock Canvas.Left="294" Canvas.Top="250" FontSize="11" Text="под. 4" />
          </Canvas>
        </Border>
        <TextBlock Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Главный инженер пополняет базу схем. Читатель открывает на экране без сохранения файла." />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="legend" Text="Файлы в базе" />
        <ListBox Height="180" ItemsSource="{Binding Schemes}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="d:HouseScheme">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Classes="primary" Margin="0,8,0,0" Content="Заменить файл" Command="{Binding SavedCommand}" />
        <Button Content="Добавить схему" Command="{Binding SavedCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
