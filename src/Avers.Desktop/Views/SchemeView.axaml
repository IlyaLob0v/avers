<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             xmlns:d="using:Avers.Domain"
             x:Class="Avers.Desktop.Views.SchemeView"
             x:DataType="vm:SchemeViewModel">
  <Grid ColumnDefinitions="*,290" Margin="16,0,16,12" VerticalAlignment="Top">
    <HeaderedContentControl Classes="group" Margin="0,0,10,0" Header="Схема стояков · JPG / PNG">
      <StackPanel>
        <Border Background="{StaticResource AccentSoft}" Height="420" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3">
          <Panel>
            <Image Source="{Binding SchemeImage}" Stretch="Uniform" Margin="4" />
            <TextBlock Text="{Binding SchemeNote}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentDark}" />
          </Panel>
        </Border>
        <TextBlock Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Главный инженер пополняет базу схем: картинки JPG или PNG до 10 МБ, название — имя файла. Радиомеханик видит схему на телефоне." />
      </StackPanel>
    </HeaderedContentControl>
    <HeaderedContentControl Grid.Column="1" Classes="group" Margin="0" Header="Файлы в базе">
      <StackPanel>
        <ListBox Height="180" ItemsSource="{Binding Schemes}" SelectedItem="{Binding SelectedScheme}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="d:HouseScheme">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel IsVisible="{Binding CanEditSchemes}">
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Classes="primary" Content="Заменить файл" Command="{Binding ReplaceSchemeFileCommand}" />
            <Button Content="Добавить схему" Margin="0" Command="{Binding AddSchemeCommand}" />
          </StackPanel>
          <TextBox Margin="0,8,0,0" Text="{Binding SchemeName}" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Переименовать" Command="{Binding RenameSchemeCommand}" />
            <Button Content="Удалить" Margin="0" Command="{Binding DeleteSchemeCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </HeaderedContentControl>
  </Grid>
</UserControl>
