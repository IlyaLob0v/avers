<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             x:Class="Avers.Desktop.Views.ReportsView"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="280,*" Margin="12">
    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="legend" Text="Параметры" />
        <TextBlock Classes="hint" Text="Начальная дата" />
        <TextBox Classes="cell" Text="01.01.2026" />
        <TextBlock Classes="hint" Margin="0,6,0,0" Text="Конечная дата" />
        <TextBox Classes="cell" Text="31.08.2026" />
        <RadioButton Margin="0,8,0,0" IsChecked="True" Content="по обслуживающим организациям" />
        <RadioButton Content="по зонам обслуживания" />
        <TextBlock Classes="hint" Margin="0,8,0,0" Text="Формат" />
        <TextBox Classes="cell" Text="XLSX" />
        <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap" Text="Метрики включаются и выключаются. XPS заменён на XLSX/PDF." />
        <Button Classes="primary" Margin="0,10,0,0" Content="Сформировать" Command="{Binding NotReadyCommand}" CommandParameter="Сформировать" />
      </StackPanel>
    </Border>
    <DataGrid ItemsSource="{Binding ReportMetrics}" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="В отчёт" Binding="{Binding On}" Width="80" />
        <DataGridTextColumn Header="Метрика" Binding="{Binding Name}" Width="280" IsReadOnly="True" />
        <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="140" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
