<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             x:Class="Avers.Desktop.Views.ReportsView"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="290,*" Margin="16,0,16,12" VerticalAlignment="Top">
    <HeaderedContentControl Classes="group" Margin="0,0,10,0" Header="Параметры">
      <StackPanel>
        <TextBlock Classes="hint" Text="Начальная дата" />
        <CalendarDatePicker Width="130" SelectedDate="{Binding ReportFromDate}" />
        <TextBlock Classes="hint" Margin="0,6,0,0" Text="Конечная дата" />
        <CalendarDatePicker Width="130" SelectedDate="{Binding ReportToDate}" />
        <RadioButton Margin="0,8,0,0" Content="по обслуживающим организациям" IsChecked="{Binding !ReportByZone}" />
        <RadioButton Content="по зонам обслуживания" IsChecked="{Binding ReportByZone}" />
        <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap" Text="В отчёт идут отмеченные метрики. Отчёт открывается в Excel." />
        <Button Classes="primary" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Сформировать" Command="{Binding ExportReportCommand}" />
        <TextBlock Classes="hint" Margin="0,12,0,0" TextWrapping="Wrap" Text="Для 1С: отгрузка и поступления за месяц начальной даты." />
        <Button HorizontalAlignment="Left" Margin="0,6,0,0" Content="Для 1С" Command="{Binding ExportForOneCCommand}" />
      </StackPanel>
    </HeaderedContentControl>
    <DataGrid Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding ReportMetrics}" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="В отчёт" Binding="{Binding On}" Width="84" />
        <DataGridTextColumn Header="Метрика" Binding="{Binding Name}" Width="300" IsReadOnly="True" />
        <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
