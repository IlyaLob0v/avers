<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             x:Class="Avers.Desktop.Views.ReportsView"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="290,*" Margin="16,0,16,12" VerticalAlignment="Top">
    <HeaderedContentControl Classes="group" Margin="0,0,10,0" Header="Параметры">
      <StackPanel>
        <TextBlock Classes="hint" Text="Начальная дата" />
        <TextBox Classes="cell" Text="01.01.2026" />
        <TextBlock Classes="hint" Margin="0,6,0,0" Text="Конечная дата" />
        <TextBox Classes="cell" Text="31.08.2026" />
        <RadioButton Margin="0,8,0,0" IsChecked="True" Content="по обслуживающим организациям" />
        <RadioButton Content="по зонам обслуживания" />
        <TextBlock Classes="hint" Margin="0,8,0,0" Text="Формат" />
        <TextBox Classes="cell" Text="XLSX" />
        <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap" Text="Метрики включаются и выключаются. XPS заменён на XLSX/PDF." />
        <Button Classes="primary" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Сформировать" Command="{Binding NotReadyCommand}" CommandParameter="Сформировать" />
      </StackPanel>
    </HeaderedContentControl>
    <DataGrid Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding ReportMetrics}" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="В отчёт" Binding="{Binding On}" Width="84" />
        <DataGridTextColumn Header="Метрика" Binding="{Binding Name}" Width="300" IsReadOnly="True" />
        <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
