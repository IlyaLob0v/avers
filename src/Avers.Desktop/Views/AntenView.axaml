<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avers.Desktop.ViewModels"
             xmlns:d="using:Avers.Domain"
             x:Class="Avers.Desktop.Views.AntenView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Margin="16,0,16,2">
      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="hint" Text="Вносит главный инженер" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding HouseCaption}" />
            <TextBlock Classes="hint" Text="{Binding HouseStats}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Схема СКПТ" Command="{Binding GoCommand}" CommandParameter="{x:Static d:AppModule.Scheme}" />
            <Button Classes="primary" Margin="0" Content="Сохранить" Command="{Binding SaveHouseCommand}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Classes="warn" IsVisible="{Binding HasFault}">
        <TextBlock Text="{Binding FaultBanner}" TextWrapping="Wrap" />
      </Border>
      <Grid ColumnDefinitions="*,*">
        <HeaderedContentControl Classes="group" Margin="0,0,5,10" Header="Обслуживающая организация и филиал">
          <StackPanel>
            <TextBlock Classes="hint" Margin="0,0,0,4" Text="Не «УК» и не «домовладелец». Сведения общие для всех домов организации." />
            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Classes="label" Text="Организация" />
              <TextBox Grid.Column="1" Classes="cell" Text="{Binding SelectedHouse.Organization.Name}" />
              <TextBlock Grid.Row="1" Classes="label" Text="Филиал" />
              <TextBox Grid.Row="1" Grid.Column="1" Classes="cell" Text="{Binding SelectedHouse.Organization.Branch}" />
              <TextBlock Grid.Row="2" Classes="label" Text="Адрес филиала" />
              <TextBox Grid.Row="2" Grid.Column="1" Classes="cell" Text="{Binding SelectedHouse.Organization.Address}" />
              <TextBlock Grid.Row="3" Classes="label" Text="Телефоны" />
              <TextBox Grid.Row="3" Grid.Column="1" Classes="cell" Text="{Binding SelectedHouse.Organization.Phones}" />
              <TextBlock Grid.Row="4" Classes="label" Text="Начальник" />
              <TextBox Grid.Row="4" Grid.Column="1" Classes="cell" Text="{Binding SelectedHouse.Organization.HeadName}" />
              <TextBlock Grid.Row="5" Classes="label" Text="Инженер" />
              <TextBox Grid.Row="5" Grid.Column="1" Classes="cell" Text="{Binding SelectedHouse.Organization.EngineerName}" />
            </Grid>
          </StackPanel>
        </HeaderedContentControl>
        <HeaderedContentControl Grid.Column="1" Classes="group" Margin="5,0,0,10" Header="Техническая информация">
          <StackPanel>
            <TextBlock Classes="hint" Margin="0,0,0,4" Text="Количество антенн отдельным числом не указывается." />
            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Classes="label" Text="Антенны, подъезды" />
              <TextBox Grid.Column="1" Classes="cell" Text="{Binding SelectedHouse.Antennas}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Classes="label" Text="Воздушные линии" />
              <TextBox Grid.Row="1" Grid.Column="1" Classes="cell" Text="{Binding SelectedHouse.AerialCables}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Classes="label" Text="Усилители" />
              <TextBox Grid.Row="2" Grid.Column="1" Classes="cell" Text="{Binding SelectedHouse.Amplifiers}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Classes="label" Text="Блоки питания" />
              <TextBox Grid.Row="3" Grid.Column="1" Classes="cell" Text="{Binding SelectedHouse.PowerSupplies}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Classes="label" Text="Ключ техэтажа" />
              <TextBox Grid.Row="4" Grid.Column="1" Classes="cell" Text="{Binding SelectedHouse.TechFloorKey}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="5" Classes="label" Text="Последний ППР" />
              <TextBox Grid.Row="5" Grid.Column="1" Classes="cell" Text="{Binding LastPprText, Mode=OneWay}" IsReadOnly="True" />
            </Grid>
          </StackPanel>
        </HeaderedContentControl>
      </Grid>
      <HeaderedContentControl Classes="group" Header="Неустранённая неисправность СКПТ">
        <StackPanel>
          <TextBlock Classes="hint" Margin="0,0,0,4" Text="Видна диспетчеру при приёме заявки по дому. Устранили — очистите поле «Неисправность»." />
          <Grid ColumnDefinitions="130,*,Auto,130" RowDefinitions="Auto,Auto">
            <TextBlock Classes="label" Text="Неисправность" />
            <TextBox Grid.Column="1" Grid.ColumnSpan="3" Classes="cell" Text="{Binding SelectedHouse.OpenFault}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Classes="label" Text="Причина" />
            <TextBox Grid.Row="1" Grid.Column="1" Classes="cell" Text="{Binding SelectedHouse.OpenFaultReason}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" Margin="10,0,8,0" Text="План устранения" />
            <TextBox Grid.Row="1" Grid.Column="3" Classes="cell" Text="{Binding EditFaultFix}" PlaceholderText="дд.мм.гггг" />
          </Grid>
        </StackPanel>
      </HeaderedContentControl>
      <HeaderedContentControl Classes="group" Header="Прочее">
        <TextBox Classes="cell" Height="48" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding SelectedHouse.OtherNotes}" />
      </HeaderedContentControl>
      <HeaderedContentControl Classes="group" Header="Заявки по дому">
        <StackPanel>
          <DataGrid Height="150" ItemsSource="{Binding HouseTickets}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="110" />
              <DataGridTextColumn Header="Кв." Binding="{Binding Apartment}" Width="50" />
              <DataGridTextColumn Header="Заявленная неисправность" Binding="{Binding Fault}" Width="280" />
              <DataGridTextColumn Header="Радиомеханик" Binding="{Binding Mechanic}" Width="180" />
              <DataGridTextColumn Header="Какую работу произвёл" Binding="{Binding WorkDone}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Classes="hint" Margin="0,6,0,0" Text="Сведения о работах вносит диспетчерская служба." />
        </StackPanel>
      </HeaderedContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
